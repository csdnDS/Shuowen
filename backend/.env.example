HOST=0.0.0.0
PORT=3001
# 托管到 HTTPS 域名后可填写，例如 https://api.example.com。
# 留空时后端会根据请求 Host / 代理头生成资源 URL。
PUBLIC_BASE_URL=

MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=shuowen

MYSQL_URI=mysql://root:shuowen_dev@127.0.0.1:3306/shuowen

# 微信小程序登录。真机/上线要填写真实值，后端会用 code 换 openid。
WX_APPID=your-wechat-appid
WX_SECRET=your-wechat-secret

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 讯飞开放平台在线语音合成。用于“小字灵”朗读回答。
XFYUN_TTS_APP_ID=
XFYUN_TTS_API_KEY=
XFYUN_TTS_API_SECRET=
XFYUN_TTS_VOICE=aisbabyxu

# 讯飞语音听写。留空时默认复用上面的讯飞 WebAPI 鉴权信息。
XFYUN_ASR_APP_ID=
XFYUN_ASR_API_KEY=
XFYUN_ASR_API_SECRET=
