{
  "name": "shuowen-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "mongo:import": "node scripts/importMongoSeed.js",
    "mysql:init": "node scripts/initMysql.js",
    "mysql:smoke": "node scripts/smokeMysql.js",
    "glyph:generate": "node scripts/generateLocalGlyphAssets.js",
    "commons:import": "node scripts/importCommonsGlyphs.js",
    "commons:loop": "node scripts/importCommonsUntilComplete.js",
    "glyph:regular": "python3 scripts/generateRegularGlyphsFromFont.py",
    "glyph:coverage": "node scripts/reportGlyphCoverage.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.18.3",
    "mongodb": "^6.18.0",
    "multer": "^2.1.1",
    "mysql2": "^3.14.3",
    "ws": "^8.21.0"
  }
}
