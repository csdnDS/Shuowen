<view class="page {{pageClass}}">

  <view class="page-header">
    <view class="eyebrow">DAILY LEARNING</view>
    <view class="page-title">每日学字</view>
    <view class="page-subtitle">随机解锁《说文》字头，记录每日学习足迹。</view>
  </view>

  <view wx:if="{{offline}}" class="banner banner-info mb-md">
    <text>当前离线模式，本次解锁仅保存在本地。</text>
  </view>

  <!-- Character of the Day -->
  <view wx:if="{{charOfDay}}" class="card cod-card mb-md" bindtap="goToCharOfDay">
    <view class="cod-header">
      <view class="cod-eyebrow">{{charOfDay.dateStr}} · 今日汉字</view>
      <view class="cod-chev">›</view>
    </view>
    <view class="cod-body">
      <view wx:if="{{charOfDay.hasOracle}}" class="cod-oracle-wrap">
        <image class="cod-oracle" src="{{charOfDay.oracleSrc}}" mode="aspectFit" binderror="onCharOfDayOracleError"></image>
        <view class="cod-oracle-label">甲骨文</view>
      </view>
      <view wx:else class="cod-char-big">{{charOfDay.char}}</view>
      <view class="cod-meta">
        <view class="cod-char">{{charOfDay.char}}<text class="cod-pinyin"> {{charOfDay.pinyin}}</text></view>
        <view class="cod-radical">部首：{{charOfDay.radical}}</view>
        <view class="cod-meaning">{{charOfDay.meaning}}</view>
        <view wx:if="{{charOfDay.aiInsight}}" class="cod-ai">{{charOfDay.aiInsight}}</view>
      </view>
    </view>
  </view>

  <!-- Stats grid -->
  <view class="stats-grid mb-md">
    <view class="stat-cell">
      <view class="stat-value">{{progress.unlockedCount}}</view>
      <view class="stat-label">已解锁</view>
    </view>
    <view class="stat-cell">
      <view class="stat-value">{{streakDays}}</view>
      <view class="stat-label">连续学习</view>
    </view>
    <view class="stat-cell stat-cell-today {{todayCount >= dailyGoal ? 'goal-done' : ''}}">
      <view class="stat-value">{{todayCount}}<text class="stat-goal">/{{dailyGoal}}</text></view>
      <view class="stat-label">今日目标</view>
    </view>
  </view>

  <!-- Achievements -->
  <view class="card">
    <view class="section-row">
      <view>
        <view class="section-title">学习成就</view>
        <view class="section-sub">完成学习、连续打卡和收藏目标</view>
      </view>
    </view>
    <view class="achievement-grid">
      <view wx:for="{{achievements}}" wx:key="title" class="achievement-cell {{item.done ? 'done' : ''}}">
        <view class="achievement-icon">{{item.done ? '✓' : '·'}}</view>
        <view class="achievement-title">{{item.title}}</view>
        <view class="achievement-desc">{{item.desc}}</view>
      </view>
    </view>
  </view>

  <!-- Progress card -->
  <view class="card">
    <view class="section-row">
      <view>
        <view class="section-title">学习进度</view>
        <view class="section-sub">{{progress.unlockedCount}} / {{progress.total}} 字</view>
      </view>
      <view class="level-badge">{{levelName}}</view>
    </view>

    <view class="progress mt-sm">
      <view class="progress-fill" style="width: {{percent}}%"></view>
    </view>
    <view class="progress-row">
      <view class="text-muted">完成度 {{percentText}}%</view>
      <view class="text-muted">{{levelHint}}</view>
    </view>

    <!-- 7-day calendar -->
    <view wx:if="{{weekCalendar.length > 0}}" class="week-cal mt-md">
      <view wx:for="{{weekCalendar}}" wx:key="dateNum" class="cal-day {{item.active ? 'cal-active' : ''}} {{item.isToday ? 'cal-today' : ''}}">
        <view class="cal-label">{{item.label}}</view>
        <view class="cal-dot"></view>
        <view class="cal-num">{{item.dateNum}}</view>
        <view wx:if="{{item.count > 0}}" class="cal-count">+{{item.count}}</view>
      </view>
    </view>

    <!-- Unlock button -->
    <view class="unlock-wrap mt-md">
      <button class="unlock-btn" loading="{{loading}}" bindtap="unlock">解锁新字</button>
      <view wx:if="{{rippleActive}}" class="unlock-ripple"></view>
    </view>

    <!-- Last unlock callout -->
    <view wx:if="{{lastUnlock}}" class="last-unlock">
      <view class="last-unlock-char">{{lastUnlock.char}}</view>
      <view class="last-unlock-msg">{{lastUnlock.message}}</view>
    </view>
  </view>

  <!-- Bookmark preview -->
  <view class="card">
    <view class="section-row">
      <view>
        <view class="section-title">收藏字</view>
        <view class="section-sub">点选进入字形演变</view>
      </view>
    </view>
    <view wx:if="{{hasBookmarks}}" class="bookmark-preview-grid">
      <view wx:for="{{bookmarksPreview}}" wx:key="char" class="bookmark-preview-cell" data-char="{{item.char}}" bindtap="goToEvolution">
        <view class="bookmark-preview-char">{{item.char}}</view>
        <view wx:if="{{item.pinyin}}" class="bookmark-preview-pinyin">{{item.pinyin}}</view>
      </view>
    </view>
    <view wx:else class="empty compact-empty">
      <view class="empty-title">还没有收藏</view>
      <view class="empty-body">在字形页点击星标，即可把喜欢的字收进这里。</view>
    </view>
  </view>

  <!-- Quiz card -->
  <view class="card">
    <view class="section-row">
      <view>
        <view class="section-title">字形测验</view>
        <view class="section-sub">检验学习成果</view>
      </view>
    </view>

    <view wx:if="{{!quizActive}}">
      <view class="text-muted mb-sm" style="font-size:24rpx; line-height:1.6">
        根据古文字描述猜测汉字，检验学习成果。
      </view>
      <view wx:if="{{quizScore.total > 0}}" class="quiz-prev-score">
        上次得分：{{quizScore.correct}} / {{quizScore.total}}
        （正确率 {{quizAccuracy}}%）
      </view>
      <button class="unlock-btn" bindtap="startQuiz">开始测验</button>
    </view>

    <view wx:else class="quiz-panel">
      <view class="quiz-era-tag">{{quiz.hintEra}} 描述</view>
      <view class="quiz-hint">{{quiz.hint}}</view>
      <view wx:if="{{quiz.canRevealMore && !quizResult}}" class="quiz-more-hint" bindtap="revealNextHint">
        查看更多提示 ›
      </view>
      <view class="quiz-question">根据上述描述，这是哪个汉字？</view>
      <view class="quiz-options">
        <view wx:for="{{quiz.options}}" wx:key="*this"
              class="quiz-opt {{quizResult ? (item === quiz.correct ? 'opt-correct' : (item === quizResult.chosen && !quizResult.isCorrect ? 'opt-wrong' : 'opt-dim')) : ''}}"
              data-char="{{item}}" bindtap="quizAnswer">{{item}}</view>
      </view>
        <view wx:if="{{quizResult}}" class="quiz-result">
        <view wx:if="{{quizResult.isCorrect}}" class="quiz-msg quiz-msg-ok">✓ 回答正确！</view>
        <view wx:else class="quiz-msg quiz-msg-err">✗ 正确答案是「{{quiz.correct}}」（{{quiz.pinyin}}）</view>
        <view class="quiz-explain">{{quiz.meaning}}</view>
        <view class="quiz-ai-card">
          <view class="quiz-ai-title">AI解字</view>
          <view wx:if="{{quizAiLoading}}" class="quiz-ai-text">正在生成讲解...</view>
          <view wx:else class="quiz-ai-text">{{quizAiStory}}</view>
        </view>
        <view class="quiz-actions mt-sm">
          <view class="btn btn-primary" style="flex:1" bindtap="startQuiz">再来一题</view>
          <view class="btn btn-ghost" style="flex:1" bindtap="goToQuizChar">查看演变</view>
        </view>
        <view class="btn btn-block mt-sm" bindtap="closeQuiz">结束（{{quizScore.correct}}/{{quizScore.total}}）</view>
      </view>
      <view wx:else class="quiz-skip">
        <view class="btn btn-ghost btn-sm" bindtap="closeQuiz">跳过</view>
      </view>
    </view>
  </view>

  <!-- Mistake book -->
  <view class="card">
    <view class="section-row">
      <view>
        <view class="section-title">错题本回顾</view>
        <view class="section-sub">复盘容易混淆的古文字线索</view>
      </view>
      <view wx:if="{{hasMistakes}}" class="btn btn-ghost btn-sm" bindtap="clearMistakeBook">清空</view>
    </view>

    <view wx:if="{{hasMistakes}}" class="mistake-list">
      <view wx:for="{{mistakeBook}}" wx:key="id" class="mistake-row" data-char="{{item.char}}" bindtap="reviewMistake">
        <view class="mistake-pair">
          <view class="mistake-correct">{{item.char}}</view>
          <view class="mistake-arrow">←</view>
          <view class="mistake-chosen">{{item.chosen}}</view>
        </view>
        <view class="mistake-main">
          <view class="mistake-title">正确「{{item.char}}」，误选「{{item.chosen}}」</view>
          <view class="mistake-meta">
            <text>{{item.stageLabel}}</text>
            <text wx:if="{{item.pinyin}}"> · {{item.pinyin}}</text>
            <text> · {{item.timeLabel}}</text>
            <text wx:if="{{item.count > 1}}"> · {{item.count}}次</text>
          </view>
          <view wx:if="{{item.meaning}}" class="mistake-meaning">{{item.meaning}}</view>
        </view>
        <view class="recent-chev">›</view>
      </view>
    </view>

    <view wx:else class="empty compact-empty">
      <view class="empty-title">暂无错题</view>
      <view class="empty-body">猜字测验答错后，会自动加入这里方便复习。</view>
    </view>
  </view>

  <!-- Recent unlocks -->
  <view class="card">
    <view class="section-row">
      <view>
        <view class="section-title">最近学习</view>
        <view class="section-sub">点击查看字形演变</view>
      </view>
    </view>

    <view wx:if="{{hasRecentUnlocks}}" class="recent-list">
      <view wx:for="{{recentUnlocks}}" wx:key="id" class="recent-row" data-char="{{item.char}}" bindtap="goToEvolution">
        <view class="recent-char">{{item.char}}</view>
        <view class="recent-meta">
          <view class="recent-label">已收录</view>
          <view class="recent-time">{{item.timeLabel}}</view>
        </view>
        <view class="recent-chev">›</view>
      </view>
    </view>

    <view wx:else class="empty">
      <view class="empty-icon">字</view>
      <view class="empty-title">还没有学习记录</view>
      <view class="empty-body">点击「解锁新字」开始今日学习。</view>
    </view>
  </view>

</view>
