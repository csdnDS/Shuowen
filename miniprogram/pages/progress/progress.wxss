/* Stats grid */

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.stat-cell {
  background: #FFFFFF;
  border: 1rpx solid #ECECEA;
  border-radius: 12rpx;
  padding: 20rpx 16rpx;
  text-align: center;
}

.stat-cell .stat-value {
  font-size: 44rpx;
  font-variant-numeric: tabular-nums;
}

.stat-cell .stat-label {
  font-size: 22rpx;
}

.stat-goal {
  font-size: 22rpx;
  color: #A0A0A0;
  font-weight: 400;
}

.stat-cell-today.goal-done {
  background: #F0FDF4;
  border-color: #BBF7D0;
}

.stat-cell-today.goal-done .stat-value {
  color: #16A34A;
}

/* Achievements */

.achievement-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
}

.achievement-cell {
  padding: 18rpx;
  border-radius: 12rpx;
  background: #FAFAF8;
  border: 1rpx solid #ECECEA;
}

.achievement-cell.done {
  background: #ECFDF5;
  border-color: #86EFAC;
}

.achievement-icon {
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: #F5F5F3;
  color: #A0A0A0;
  font-size: 24rpx;
  font-weight: 700;
}

.achievement-cell.done .achievement-icon {
  background: #16A34A;
  color: #FFFFFF;
}

.achievement-title {
  color: #1A1A1A;
  font-size: 25rpx;
  font-weight: 600;
  margin-top: 12rpx;
}

.achievement-desc {
  color: #6B6B6B;
  font-size: 21rpx;
  margin-top: 4rpx;
}

/* Bookmark preview */

.bookmark-preview-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 10rpx;
}

.bookmark-preview-cell {
  min-height: 86rpx;
  border-radius: 10rpx;
  background: #FAFAF8;
  border: 1rpx solid #ECECEA;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.bookmark-preview-char {
  color: #1A1A1A;
  font-size: 34rpx;
  font-weight: 600;
}

.bookmark-preview-pinyin {
  color: #A0A0A0;
  font-size: 16rpx;
  margin-top: 2rpx;
}

.compact-empty {
  padding: 18rpx 0 4rpx;
}

/* Progress card */

.level-badge {
  background: #EFF6FF;
  color: #2563EB;
  font-size: 24rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

.progress-row {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
  font-size: 22rpx;
}

/* 7-day calendar */

.week-cal {
  display: flex;
  justify-content: space-between;
  gap: 4rpx;
}

.cal-day {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 0;
  border-radius: 10rpx;
  background: #FAFAF8;
}

.cal-day.cal-active {
  background: #EFF6FF;
}

.cal-day.cal-today {
  border: 1rpx solid #BFDBFE;
}

.cal-label {
  font-size: 18rpx;
  color: #A0A0A0;
}

.cal-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #DCDCD8;
}

.cal-active .cal-dot {
  background: #2563EB;
}

.cal-num {
  font-size: 20rpx;
  color: #6B6B6B;
  font-variant-numeric: tabular-nums;
}

.cal-today .cal-num {
  color: #2563EB;
  font-weight: 600;
}

.cal-count {
  font-size: 16rpx;
  color: #2563EB;
  font-weight: 500;
}

/* Unlock button */

.unlock-wrap {
  position: relative;
  display: flex;
  justify-content: center;
}

.unlock-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 12rpx;
  background: #1A1A1A;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 2rpx;
}

.unlock-btn:active {
  background: #000000;
}

.unlock-ripple {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: rgba(37, 99, 235, 0.18);
  transform: translate(-50%, -50%);
  animation: ripple 0.72s ease-out forwards;
  pointer-events: none;
}

@keyframes ripple {
  to {
    width: 600rpx;
    height: 600rpx;
    opacity: 0;
  }
}

.last-unlock {
  margin-top: 20rpx;
  padding: 20rpx;
  background: #EFF6FF;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.last-unlock-char {
  width: 88rpx;
  height: 88rpx;
  border-radius: 12rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.last-unlock-msg {
  color: #1D4ED8;
  font-size: 26rpx;
}

/* Quiz */

.quiz-panel {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.quiz-hint {
  background: #F5F5F3;
  border-radius: 12rpx;
  padding: 20rpx;
  color: #1A1A1A;
  font-size: 26rpx;
  line-height: 1.7;
  border-left: 4rpx solid #2563EB;
}

.quiz-question {
  color: #6B6B6B;
  font-size: 24rpx;
}

.quiz-options {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}

.quiz-opt {
  height: 120rpx;
  border-radius: 12rpx;
  background: #FAFAF8;
  border: 2rpx solid #ECECEA;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  font-weight: 600;
  color: #1A1A1A;
  transition: background 0.2s ease;
}

.quiz-opt:active {
  background: #EFF6FF;
  border-color: #BFDBFE;
}

.opt-correct {
  background: #F0FDF4;
  border-color: #4ADE80;
  color: #16A34A;
}

.opt-wrong {
  background: #FEF2F2;
  border-color: #FCA5A5;
  color: #DC2626;
}

.opt-dim {
  opacity: 0.4;
}

.quiz-result {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.quiz-msg {
  font-size: 26rpx;
  font-weight: 600;
  padding: 14rpx 18rpx;
  border-radius: 10rpx;
}

.quiz-msg-ok {
  background: #F0FDF4;
  color: #16A34A;
}

.quiz-msg-err {
  background: #FEF2F2;
  color: #DC2626;
}

.quiz-explain {
  color: #6B6B6B;
  font-size: 24rpx;
  line-height: 1.65;
}

.quiz-ai-card {
  background: #F8FAFC;
  border: 1rpx solid #E2E8F0;
  border-radius: 12rpx;
  padding: 18rpx;
}

.quiz-ai-title {
  color: #1D4ED8;
  font-size: 22rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.quiz-ai-text {
  color: #334155;
  font-size: 24rpx;
  line-height: 1.65;
}

.quiz-actions {
  display: flex;
  gap: 12rpx;
}

.quiz-skip {
  display: flex;
  justify-content: flex-end;
}

.quiz-era-tag {
  display: inline-flex;
  align-items: center;
  height: 36rpx;
  padding: 0 12rpx;
  border-radius: 6rpx;
  background: #EFF6FF;
  color: #2563EB;
  font-size: 20rpx;
  font-weight: 500;
  align-self: flex-start;
}

.quiz-prev-score {
  color: #6B6B6B;
  font-size: 22rpx;
  margin-bottom: 14rpx;
}

/* Mistake book */

.mistake-list {
  display: flex;
  flex-direction: column;
}

.mistake-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 4rpx;
}

.mistake-row + .mistake-row {
  border-top: 1rpx solid #F0F0EE;
}

.mistake-row:active {
  background: #FAFAF8;
}

.mistake-pair {
  width: 120rpx;
  flex-shrink: 0;
  display: grid;
  grid-template-columns: 1fr 28rpx 1fr;
  align-items: center;
  gap: 4rpx;
}

.mistake-correct,
.mistake-chosen {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.mistake-correct {
  background: #ECFDF5;
  color: #047857;
  border: 1rpx solid #BBF7D0;
}

.mistake-chosen {
  background: #FEF2F2;
  color: #B91C1C;
  border: 1rpx solid #FECACA;
}

.mistake-arrow {
  color: #A0A0A0;
  font-size: 20rpx;
  text-align: center;
}

.mistake-main {
  flex: 1;
  min-width: 0;
}

.mistake-title {
  color: #1A1A1A;
  font-size: 25rpx;
  font-weight: 600;
}

.mistake-meta {
  color: #94A3B8;
  font-size: 21rpx;
  margin-top: 4rpx;
}

.mistake-meaning {
  color: #64748B;
  font-size: 22rpx;
  margin-top: 4rpx;
  line-height: 1.45;
}

/* Recent list */

.recent-list {
  display: flex;
  flex-direction: column;
}

.recent-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 4rpx;
}

.recent-row + .recent-row {
  border-top: 1rpx solid #F0F0EE;
}

.recent-row:active {
  background: #FAFAF8;
}

.recent-char {
  width: 72rpx;
  height: 72rpx;
  border-radius: 10rpx;
  background: #FAFAF8;
  border: 1rpx solid #ECECEA;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #1A1A1A;
  font-weight: 500;
  flex-shrink: 0;
}

.recent-meta {
  flex: 1;
}

.recent-label {
  color: #1A1A1A;
  font-size: 26rpx;
}

.recent-time {
  color: #A0A0A0;
  font-size: 22rpx;
  margin-top: 2rpx;
}

.recent-chev {
  color: #C0C0BE;
  font-size: 32rpx;
}

/* Character of the Day */

.cod-card {
  background: linear-gradient(135deg, #1E3A8A 0%, #1D4ED8 60%, #2563EB 100%);
  color: #FFFFFF;
}

.cod-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.cod-eyebrow {
  font-size: 20rpx;
  color: rgba(255,255,255,0.7);
  letter-spacing: 1rpx;
}

.cod-chev {
  font-size: 28rpx;
  color: rgba(255,255,255,0.5);
}

.cod-body {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.cod-oracle-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.cod-oracle {
  width: 120rpx;
  height: 120rpx;
  background: #FFF9EC;
  border-radius: 14rpx;
  padding: 10rpx;
  box-sizing: border-box;
}

.cod-oracle-label {
  font-size: 18rpx;
  color: rgba(255,255,255,0.6);
  margin-top: 6rpx;
  letter-spacing: 1rpx;
}

.cod-char-big {
  width: 120rpx;
  height: 120rpx;
  background: rgba(255,255,255,0.15);
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 70rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.cod-meta {
  flex: 1;
  min-width: 0;
}

.cod-char {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.2;
}

.cod-pinyin {
  font-size: 24rpx;
  font-weight: 400;
  color: rgba(255,255,255,0.8);
  letter-spacing: 1rpx;
}

.cod-radical {
  font-size: 22rpx;
  color: rgba(255,255,255,0.7);
  margin-top: 6rpx;
}

.cod-meaning {
  font-size: 24rpx;
  color: rgba(255,255,255,0.9);
  margin-top: 8rpx;
  line-height: 1.5;
}

.cod-ai {
  font-size: 22rpx;
  color: rgba(255,255,255,0.86);
  margin-top: 10rpx;
  line-height: 1.5;
  padding-top: 10rpx;
  border-top: 1rpx solid rgba(255,255,255,0.18);
}

/* Progressive quiz hint */

.quiz-more-hint {
  font-size: 22rpx;
  color: #2563EB;
  padding: 8rpx 0;
  margin-top: -4rpx;
  margin-bottom: 8rpx;
}
