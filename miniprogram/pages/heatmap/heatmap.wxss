/* Visit tip */

.visit-tip-card {
  background: linear-gradient(135deg, #F0FDF4, #DCFCE7);
  border: 1rpx solid #BBF7D0;
}

.visit-tip-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.visit-tip-icon {
  font-size: 36rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.visit-tip-text {
  color: #15803D;
  font-size: 24rpx;
  line-height: 1.7;
  flex: 1;
}

/* Area ranking list */

.area-list {
  display: flex;
  flex-direction: column;
}

.area-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 4rpx;
}

.area-row + .area-row {
  border-top: 1rpx solid #F0F0EE;
}

.area-row:active {
  background: #FAFAF8;
}

.area-rank {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #F5F5F3;
  color: #6B6B6B;
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.area-row:nth-child(1) .area-rank {
  background: #FEF3C7;
  color: #B45309;
}
.area-row:nth-child(2) .area-rank {
  background: #E5E7EB;
  color: #374151;
}
.area-row:nth-child(3) .area-rank {
  background: #FED7AA;
  color: #9A3412;
}

.area-meta {
  width: 200rpx;
}

.area-name {
  color: #1A1A1A;
  font-size: 28rpx;
  font-weight: 500;
}

.area-label {
  font-size: 22rpx;
  margin-top: 2rpx;
}

.area-bar {
  flex: 1;
  height: 10rpx;
  background: #F0F0EE;
  border-radius: 5rpx;
  overflow: hidden;
}

.area-bar-fill {
  height: 100%;
  border-radius: 5rpx;
  transition: width 0.4s ease;
}

.area-value {
  width: 70rpx;
  text-align: right;
  color: #1A1A1A;
  font-size: 28rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

/* Legend */

.legend-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx 24rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.legend-label {
  color: #1A1A1A;
  font-size: 26rpx;
  font-weight: 500;
}

.legend-range {
  color: #A0A0A0;
  font-size: 22rpx;
  margin-left: auto;
}

/* Bottom sheet */

.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.32);
  z-index: 20;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  padding: 18rpx 32rpx 56rpx;
  z-index: 21;
  box-shadow: 0 -12rpx 32rpx rgba(0, 0, 0, 0.08);
  animation: slide-up 0.25s ease-out;
}

@keyframes slide-up {
  from { transform: translateY(100%); }
  to   { transform: translateY(0); }
}

.sheet-handle {
  width: 64rpx;
  height: 6rpx;
  background: #DCDCD8;
  border-radius: 3rpx;
  margin: 0 auto 20rpx;
}

.sheet-eyebrow {
  color: #2563EB;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.sheet-title {
  color: #1A1A1A;
  font-size: 40rpx;
  font-weight: 700;
  margin-top: 6rpx;
}

.sheet-meta {
  display: flex;
  gap: 10rpx;
  margin-top: 14rpx;
}

.sheet-stat {
  margin: 32rpx 0;
  padding: 24rpx;
  background: #FAFAF8;
  border-radius: 12rpx;
  text-align: center;
}

.sheet-stat-value {
  color: #1A1A1A;
  font-size: 72rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  font-variant-numeric: tabular-nums;
}

.sheet-stat-label {
  color: #6B6B6B;
  font-size: 24rpx;
  margin-top: 4rpx;
}

.sheet-desc {
  color: #6B6B6B;
  font-size: 24rpx;
  line-height: 1.7;
  padding: 0 4rpx;
}
