<view class="page">

  <view class="page-header">
    <view class="eyebrow">PARK HEATMAP</view>
    <view class="page-title">园区热力</view>
    <view class="page-subtitle">许慎文化园五处重点区域的实时游客热度。</view>
  </view>

  <view wx:if="{{offline}}" class="banner banner-info mb-md">
    <text>当前未连接到本地服务，显示离线示例数据。</text>
  </view>

  <!-- Park area ranking list (replaces colorful map) -->
  <view class="card">
    <view class="section-row">
      <view>
        <view class="section-title">区域热度排行</view>
        <view class="section-sub">点击区域查看详情</view>
      </view>
      <view class="btn btn-sm" bindtap="refreshHeatmap">刷新</view>
    </view>

    <view wx:if="{{loading}}" class="loading-shimmer" style="height:96rpx; border-radius:12rpx; margin-bottom:12rpx"></view>

    <view wx:else class="area-list">
      <view wx:for="{{areas}}" wx:key="id" class="area-row" data-id="{{item.id}}" bindtap="selectArea">
        <view class="area-rank">{{item.rank}}</view>
        <view class="area-meta">
          <view class="area-name">{{item.name}}</view>
          <view class="area-label" style="color: {{item.color}}">{{item.heatLabel}}</view>
        </view>
        <view class="area-bar">
          <view class="area-bar-fill" style="width: {{item.heat}}%; background: {{item.color}}"></view>
        </view>
        <view class="area-value">{{item.heat}}</view>
      </view>
    </view>
  </view>

  <!-- Legend -->
  <view class="card">
    <view class="section-row">
      <view class="section-title">热度等级</view>
    </view>
    <view class="legend-grid">
      <view wx:for="{{legend}}" wx:key="label" class="legend-item">
        <view class="legend-dot" style="background: {{item.color}}"></view>
        <view class="legend-label">{{item.label}}</view>
        <view class="legend-range">{{item.range}}</view>
      </view>
    </view>
  </view>

  <!-- Detail sheet -->
  <view wx:if="{{detailVisible}}" class="sheet-mask" bindtap="hideDetail"></view>
  <view wx:if="{{detailVisible}}" class="sheet">
    <view class="sheet-handle"></view>
    <view class="sheet-eyebrow">区域热度</view>
    <view class="sheet-title">{{active.name}}</view>
    <view class="sheet-meta">
      <view class="tag tag-blue">第 {{active.rank}} 位</view>
      <view class="tag" style="color: {{active.color}}; background: rgba(0,0,0,0.04)">{{active.heatLabel}}</view>
    </view>
    <view class="sheet-stat">
      <view class="sheet-stat-value">{{active.heat}}</view>
      <view class="sheet-stat-label">当前热度指数</view>
    </view>
    <view class="btn btn-primary btn-block" bindtap="refreshHeatmap">刷新热度</view>
  </view>

</view>
