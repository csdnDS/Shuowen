/* Search entry and floating panel */

.search-launcher {
  background: #FFFFFF;
  border: 1rpx solid #ECECEA;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.search-launcher:active {
  background: #FAFAF8;
}

.search-launcher-main {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.search-launcher-icon {
  width: 54rpx;
  height: 54rpx;
  line-height: 54rpx;
  text-align: center;
  border-radius: 50%;
  background: #EFF6FF;
  color: #2563EB;
  font-size: 30rpx;
  font-weight: 700;
}

.search-launcher-title {
  color: #1A1A1A;
  font-size: 27rpx;
  font-weight: 700;
}

.search-launcher-sub {
  color: #A0A0A0;
  font-size: 21rpx;
  margin-top: 2rpx;
}

.search-overlay {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
  background: rgba(15, 23, 42, 0.34);
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding: 160rpx 28rpx 0;
  box-sizing: border-box;
}

.search-sheet {
  width: 100%;
  max-height: 72vh;
  overflow-y: auto;
  background: #FFFFFF;
  border-radius: 18rpx;
  padding: 24rpx;
  box-sizing: border-box;
  box-shadow: 0 24rpx 60rpx rgba(15, 23, 42, 0.2);
}

.search-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.search-sheet-title {
  color: #1A1A1A;
  font-size: 32rpx;
  font-weight: 700;
}

.search-sheet-sub {
  color: #64748B;
  font-size: 22rpx;
  margin-top: 4rpx;
}

.search-sheet-close {
  width: 58rpx;
  height: 58rpx;
  line-height: 58rpx;
  text-align: center;
  border-radius: 50%;
  background: #F5F5F3;
  color: #6B6B6B;
  font-size: 36rpx;
  flex-shrink: 0;
}

.ask-sheet {
  width: 100%;
  max-height: 78vh;
  overflow-y: auto;
  background: #FFFFFF;
  border-radius: 18rpx;
  padding: 24rpx;
  box-sizing: border-box;
  box-shadow: 0 24rpx 60rpx rgba(15, 23, 42, 0.2);
}

.ask-sheet-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.ask-sheet-mascot {
  width: 72rpx;
  height: 88rpx;
  flex-shrink: 0;
}

.ask-sheet-title-wrap {
  flex: 1;
  min-width: 0;
}

.ask-sheet-title {
  color: #1A1A1A;
  font-size: 32rpx;
  font-weight: 700;
}

.ask-sheet-sub {
  color: #64748B;
  font-size: 22rpx;
  margin-top: 4rpx;
}

.ask-message-list {
  min-height: 180rpx;
  max-height: 420rpx;
  overflow-y: auto;
  padding: 18rpx 0;
}

.ask-empty {
  color: #94A3B8;
  font-size: 24rpx;
  line-height: 1.6;
  padding: 12rpx 4rpx;
}

.ask-message {
  display: flex;
  flex-direction: column;
  margin-bottom: 14rpx;
}

.ask-message-user {
  align-items: flex-end;
}

.ask-message-assistant {
  align-items: flex-start;
}

.ask-assistant-content {
  max-width: 94%;
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
}

.ask-bubble {
  max-width: 82%;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  color: #334155;
  background: #F8FAFC;
  font-size: 25rpx;
  line-height: 1.65;
}

.ask-assistant-content .ask-bubble {
  max-width: none;
  min-width: 0;
  flex: 0 1 auto;
}

.ask-message-user .ask-bubble {
  background: #1D4ED8;
  color: #FFFFFF;
}

.ask-speak-btn {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #FFF7ED;
  border: 1rpx solid #FED7AA;
  color: #C2410C;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
  margin-top: 4rpx;
}

.ask-speak-icon {
  width: 0;
  height: 0;
  margin-left: 3rpx;
  border-top: 8rpx solid transparent;
  border-bottom: 8rpx solid transparent;
  border-left: 12rpx solid #C2410C;
}

.ask-speak-playing {
  background: #EFF6FF;
  border-color: #BFDBFE;
  color: #1D4ED8;
}

.ask-speak-playing .ask-speak-icon {
  width: 13rpx;
  height: 13rpx;
  margin-left: 0;
  border: 0;
  border-radius: 3rpx;
  background: #1D4ED8;
}

.ask-speak-loading .ask-speak-icon {
  width: 16rpx;
  height: 16rpx;
  margin-left: 0;
  border: 3rpx solid rgba(194, 65, 12, 0.22);
  border-top-color: #C2410C;
  border-radius: 50%;
  animation: askSpeakSpin 0.8s linear infinite;
}

@keyframes askSpeakSpin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.ask-thinking {
  color: #64748B;
}

.ask-presets {
  display: flex;
  gap: 10rpx;
  margin-bottom: 14rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.ask-preset {
  height: 48rpx;
  line-height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #EFF6FF;
  color: #2563EB;
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.voice-ask-panel {
  margin-bottom: 14rpx;
}

.voice-ask-btn {
  width: 100%;
  min-height: 72rpx;
  border-radius: 12rpx;
  background: #FFFDF7;
  border: 1rpx solid #F2D7A0;
  color: #92400E;
  font-size: 25rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.voice-ask-recording {
  background: #FEF2F2;
  border-color: #FCA5A5;
  color: #B91C1C;
}

.voice-ask-disabled {
  background: #F5F5F3;
  border-color: #ECECEA;
  color: #A0A0A0;
}

.voice-ask-icon {
  font-size: 28rpx;
}

.voice-ask-text {
  margin-top: 10rpx;
  color: #64748B;
  font-size: 22rpx;
  line-height: 1.5;
}

.search-row {
  position: relative;
  display: flex;
  align-items: center;
}

.search-input {
  flex: 1;
  height: 96rpx;
  padding: 0 84rpx 0 24rpx;
  border-radius: 12rpx;
  border: 1rpx solid #ECECEA;
  background: #FAFAF8;
  font-size: 40rpx;
  font-weight: 600;
  color: #1A1A1A;
  letter-spacing: 4rpx;
  box-sizing: border-box;
}

.search-placeholder {
  color: #C0C0BE;
  font-size: 28rpx;
  font-weight: 400;
  letter-spacing: 0;
}

.search-icon {
  position: absolute;
  right: 24rpx;
  color: #A0A0A0;
  font-size: 28rpx;
  padding: 8rpx;
}

.search-hint {
  color: #C0C0BE;
  font-size: 20rpx;
  margin-top: 10rpx;
}

.suggest-dropdown {
  margin-top: 14rpx;
  border: 1rpx solid #ECECEA;
  border-radius: 12rpx;
  overflow: hidden;
  background: #FFFFFF;
}

.suggest-item {
  display: flex;
  align-items: baseline;
  padding: 18rpx 20rpx;
  border-bottom: 1rpx solid #F2F2F0;
}

.suggest-item:last-child {
  border-bottom: none;
}

.suggest-item-char {
  font-size: 32rpx;
  color: #1A1A1A;
  margin-right: 16rpx;
}

.suggest-item-pinyin {
  font-size: 22rpx;
  color: #A0A0A0;
}

.history-row {
  margin-top: 20rpx;
}

.history-label {
  color: #A0A0A0;
  font-size: 22rpx;
  margin-bottom: 10rpx;
  letter-spacing: 1rpx;
}

.history-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

/* AI feature group */

.ai-feature-card {
  background: #FFFFFF;
  border: 1rpx solid #ECECEA;
  border-radius: 14rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.card + .ai-feature-card,
.ai-feature-card + .card {
  margin-top: 20rpx;
}

.ai-feature-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.ai-feature-title {
  color: #1A1A1A;
  font-size: 30rpx;
  font-weight: 700;
}

.ai-feature-sub {
  color: #64748B;
  font-size: 22rpx;
  margin-top: 4rpx;
}

.ai-feature-toggle {
  color: #2563EB;
  font-size: 24rpx;
  font-weight: 500;
  flex-shrink: 0;
}

/* Daily AI recommendation */

.daily-card {
  background: #FFFFFF;
  border: 1rpx solid #E8E2D4;
  border-radius: 14rpx;
  padding: 24rpx;
  box-sizing: border-box;
  margin-top: 18rpx;
}

.card + .daily-card,
.daily-card + .card {
  margin-top: 20rpx;
}

.daily-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.daily-kicker {
  color: #9A6A12;
  font-size: 21rpx;
  font-weight: 600;
}

.daily-title {
  color: #1A1A1A;
  font-size: 31rpx;
  font-weight: 700;
  margin-top: 4rpx;
}

.daily-loading {
  height: 168rpx;
  border-radius: 12rpx;
  margin-top: 18rpx;
}

.daily-body {
  display: flex;
  gap: 20rpx;
  margin-top: 18rpx;
}

.daily-glyph {
  width: 132rpx;
  height: 132rpx;
  border-radius: 12rpx;
  background: #FFFDF7;
  border: 1rpx solid #F1D99D;
  color: #1A1A1A;
  font-size: 84rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.daily-main {
  flex: 1;
  min-width: 0;
}

.daily-meta {
  color: #9A6A12;
  font-size: 23rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.daily-insight {
  color: #334155;
  font-size: 24rpx;
  line-height: 1.65;
}

.daily-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 16rpx;
}

.daily-btn {
  margin: 0;
  padding: 0 18rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 8rpx;
  background: #1D4ED8;
  color: #FFFFFF;
  font-size: 22rpx;
  flex-shrink: 0;
}

/* AI learning dashboard */

.learning-card {
  background: #FFFFFF;
  border: 1rpx solid #D8E6E0;
  border-radius: 14rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.daily-card + .learning-card,
.learning-card + .quiz-card {
  margin-top: 20rpx;
}

.learning-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.learning-kicker {
  color: #047857;
  font-size: 21rpx;
  font-weight: 600;
}

.learning-title {
  color: #1A1A1A;
  font-size: 31rpx;
  font-weight: 700;
  margin-top: 4rpx;
}

.learning-refresh {
  margin: 0;
  padding: 0 18rpx;
  height: 52rpx;
  line-height: 52rpx;
  border-radius: 8rpx;
  background: #ECFDF5;
  color: #047857;
  font-size: 22rpx;
  flex-shrink: 0;
}

.learning-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 18rpx;
}

.learning-stat {
  min-height: 112rpx;
  border-radius: 12rpx;
  background: #F8FAFC;
  border: 1rpx solid #E2E8F0;
  padding: 14rpx 10rpx;
  box-sizing: border-box;
  text-align: center;
}

.learning-stat-value {
  color: #0F172A;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.3;
}

.learning-stat-label {
  color: #64748B;
  font-size: 20rpx;
  margin-top: 8rpx;
}

.learning-loading {
  height: 180rpx;
  border-radius: 12rpx;
  margin-top: 18rpx;
}

.learning-body {
  margin-top: 18rpx;
}

.learning-summary {
  color: #334155;
  font-size: 24rpx;
  line-height: 1.65;
}

.learning-next-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 16rpx;
}

.learning-next {
  min-height: 112rpx;
  border-radius: 12rpx;
  background: #F0FDF4;
  border: 1rpx solid #BBF7D0;
  padding: 12rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.learning-next:active {
  background: #DCFCE7;
}

.learning-next-char {
  color: #064E3B;
  font-size: 42rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.learning-next-meta {
  color: #047857;
  font-size: 19rpx;
  line-height: 1.45;
  min-width: 0;
}

.learning-reason {
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  border-radius: 10rpx;
  background: #F8FAFC;
  color: #475569;
  font-size: 22rpx;
  line-height: 1.55;
}

/* AI quiz */

.quiz-card {
  background: #FFFFFF;
  border: 1rpx solid #E4E8F0;
  border-radius: 14rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.daily-card + .quiz-card,
.quiz-card + .card {
  margin-top: 20rpx;
}

.quiz-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.quiz-kicker {
  color: #2563EB;
  font-size: 21rpx;
  font-weight: 600;
}

.quiz-title {
  color: #1A1A1A;
  font-size: 31rpx;
  font-weight: 700;
  margin-top: 4rpx;
}

.quiz-next,
.quiz-detail-btn {
  margin: 0;
  padding: 0 18rpx;
  height: 52rpx;
  line-height: 52rpx;
  border-radius: 8rpx;
  background: #EFF6FF;
  color: #2563EB;
  font-size: 22rpx;
  flex-shrink: 0;
}

.quiz-loading {
  height: 300rpx;
  border-radius: 12rpx;
  margin-top: 18rpx;
}

.quiz-body {
  margin-top: 18rpx;
}

.quiz-stage {
  color: #64748B;
  font-size: 22rpx;
  margin-bottom: 10rpx;
}

.quiz-glyph-panel {
  height: 280rpx;
  border-radius: 12rpx;
  background: #FAFAF8;
  border: 1rpx solid #ECECEA;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.quiz-glyph-img {
  width: 230rpx;
  height: 230rpx;
}

.quiz-glyph-text {
  color: #1A1A1A;
  font-size: 138rpx;
  font-weight: 600;
}

.quiz-options {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-top: 18rpx;
}

.quiz-option {
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 10rpx;
  background: #F5F5F3;
  border: 1rpx solid #ECECEA;
  color: #1A1A1A;
  font-size: 34rpx;
  font-weight: 600;
}

.quiz-option:active {
  background: #EFF6FF;
  border-color: #BFDBFE;
}

.quiz-option.correct {
  background: #ECFDF5;
  border-color: #86EFAC;
  color: #047857;
}

.quiz-option.wrong {
  background: #FEF2F2;
  border-color: #FECACA;
  color: #B91C1C;
}

.quiz-result {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 12rpx;
  background: #FFFDF7;
  border: 1rpx solid #F2D7A0;
}

.quiz-result-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.quiz-result-title {
  color: #92400E;
  font-size: 25rpx;
  font-weight: 700;
}

.quiz-result-sub {
  color: #9A6A12;
  font-size: 21rpx;
  margin-top: 4rpx;
}

.quiz-answer-char {
  width: 76rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 12rpx;
  background: #FFFFFF;
  border: 1rpx solid #F2D7A0;
  color: #1A1A1A;
  font-size: 44rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.quiz-answer-meta {
  color: #64748B;
  font-size: 22rpx;
  line-height: 1.5;
  margin-top: 12rpx;
}

.quiz-explaining {
  color: #64748B;
  font-size: 23rpx;
  margin-top: 14rpx;
}

.quiz-explain-row {
  display: flex;
  gap: 14rpx;
  margin-top: 14rpx;
}

.quiz-mascot {
  width: 78rpx;
  height: 96rpx;
  flex-shrink: 0;
}

.quiz-explain-text {
  color: #334155;
  font-size: 24rpx;
  line-height: 1.65;
  flex: 1;
}

.quiz-explain-main {
  flex: 1;
  min-width: 0;
}

.quiz-diagnosis {
  padding: 14rpx 16rpx;
  border-radius: 10rpx;
  background: #ECFDF5;
  border: 1rpx solid #BBF7D0;
  margin-bottom: 12rpx;
}

.quiz-diagnosis-label {
  color: #047857;
  font-size: 20rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.quiz-diagnosis-text {
  color: #334155;
  font-size: 23rpx;
  line-height: 1.55;
}

.quiz-result-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 18rpx;
}

.quiz-action-primary,
.quiz-action-secondary {
  margin: 0;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.quiz-action-primary {
  background: #1D4ED8;
  color: #FFFFFF;
}

.quiz-action-secondary {
  background: #FFFFFF;
  color: #1D4ED8;
  border: 1rpx solid #BFDBFE;
}

.assistant-fab {
  position: fixed;
  right: 28rpx;
  bottom: 168rpx;
  height: 80rpx;
  padding: 0 24rpx 0 14rpx;
  border-radius: 40rpx;
  background: #FFFDF7;
  border: 1rpx solid #F2D7A0;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 20;
}

.assistant-fab-img {
  width: 48rpx;
  height: 58rpx;
}

.assistant-fab-label {
  margin-left: 8rpx;
  font-size: 24rpx;
  color: #92400E;
  font-weight: 500;
}

/* Stroke filter */

.catalog-toggle-row {
  margin-bottom: 0;
}

.catalog-toggle {
  color: #2563EB;
  font-size: 24rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.catalog-preview {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #FAFAF8;
  border: 1rpx solid #ECECEA;
}

.catalog-preview-text {
  color: #6B6B6B;
  font-size: 22rpx;
  line-height: 1.5;
}

.catalog-preview-chars {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 12rpx;
  overflow: hidden;
  white-space: nowrap;
}

.catalog-preview-char {
  width: 42rpx;
  height: 42rpx;
  line-height: 42rpx;
  text-align: center;
  border-radius: 8rpx;
  background: #FFFFFF;
  border: 1rpx solid #ECECEA;
  color: #1A1A1A;
  font-size: 26rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.stroke-filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.stroke-chip {
  font-size: 22rpx;
  color: #6B6B6B;
  padding: 6rpx 18rpx;
  background: #F5F5F3;
  border-radius: 999rpx;
  border: 1rpx solid transparent;
}

.stroke-chip-active {
  background: #EFF6FF;
  color: #2563EB;
  border-color: #BFDBFE;
  font-weight: 500;
}

/* Catalog */

.catalog-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 10rpx;
  margin-top: 4rpx;
}

.catalog-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx 4rpx;
  background: #F5F5F3;
  border-radius: 10rpx;
  color: #6B6B6B;
  transition: background 0.15s ease, color 0.15s ease;
}

.catalog-pinyin {
  font-size: 16rpx;
  color: #C0C0BE;
  letter-spacing: 0;
  margin-top: 2rpx;
  overflow: hidden;
  white-space: nowrap;
}

.catalog-cell.has-detail {
  background: #FFFFFF;
  border: 1rpx solid #ECECEA;
  color: #1A1A1A;
}

.catalog-cell:active {
  background: #EFF6FF;
  color: #2563EB;
}

.catalog-char {
  font-size: 36rpx;
  font-weight: 500;
}

/* Current character */

.current-card {
  padding: 32rpx 24rpx;
}

.current-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.current-glyph {
  width: 160rpx;
  height: 160rpx;
  border-radius: 14rpx;
  background: #F5F5F3;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 100rpx;
  font-weight: 600;
  color: #1A1A1A;
  flex-shrink: 0;
}

.current-meta {
  flex: 1;
  min-width: 0;
}

.current-pinyin {
  color: #2563EB;
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  margin-bottom: 4rpx;
}

.current-radical {
  color: #6B6B6B;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.current-strokes {
  color: #A0A0A0;
  font-size: 22rpx;
  margin-left: 8rpx;
}

.current-meaning {
  color: #1A1A1A;
  font-size: 26rpx;
  line-height: 1.55;
}

.bookmark-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #FAFAF8;
  border: 1rpx solid #ECECEA;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #C0C0BE;
  font-size: 32rpx;
  flex-shrink: 0;
}

.bookmark-btn.on {
  background: #FFF7E8;
  border-color: #F5C770;
  color: #D97706;
}

/* Compare strip */

.compare-strip {
  background: #FAFAF8;
  border: 1rpx solid #ECECEA;
  border-radius: 12rpx;
  padding: 18rpx 0 16rpx;
}

.compare-head {
  padding: 0 18rpx 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.compare-toggle {
  color: #2563EB;
  font-size: 24rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.compare-title {
  color: #1A1A1A;
  font-size: 26rpx;
  font-weight: 600;
}

.compare-sub {
  color: #A0A0A0;
  font-size: 20rpx;
  margin-top: 4rpx;
  line-height: 1.4;
}

.compare-scroll {
  width: 100%;
  white-space: nowrap;
}

.compare-track {
  display: inline-flex;
  align-items: stretch;
  padding: 0 18rpx;
}

.compare-stage-wrap {
  display: inline-flex;
  align-items: center;
}

.compare-stage {
  width: 116rpx;
  min-height: 176rpx;
  background: #FFFFFF;
  border: 1rpx solid #ECECEA;
  border-radius: 12rpx;
  padding: 10rpx 8rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.compare-arrow {
  width: 30rpx;
  text-align: center;
  color: #A0A0A0;
  font-size: 34rpx;
  font-weight: 600;
}

.compare-glyph-wrap {
  width: 108rpx;
  height: 108rpx;
  border-radius: 10rpx;
  background: #FFFDF7;
  border: 1rpx solid #F4E4BF;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.compare-img {
  width: 100rpx;
  height: 100rpx;
}

.compare-char {
  width: 100%;
  height: 100%;
  font-size: 64rpx;
  color: #1A1A1A;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}

.compare-char.era-oracle {
  font-family: 'shuowen-oracle', "STKaiti", "Kaiti SC", serif;
  font-size: 62rpx;
}

.compare-char.era-bronze {
  font-family: 'shuowen-bronze', "STKaiti", serif;
  font-size: 62rpx;
}

.compare-char.era-seal {
  font-family: 'shuowen-seal', "STSong", "Songti SC", serif;
  font-size: 58rpx;
}

.compare-char.era-clerical {
  font-family: 'shuowen-clerical', "STLiti", "Lishu", serif;
  font-size: 58rpx;
  font-weight: 500;
}

.compare-char.era-regular {
  font-size: 60rpx;
  font-weight: 500;
}

.compare-label {
  color: #1A1A1A;
  font-size: 21rpx;
  font-weight: 600;
  margin-top: 10rpx;
}

.compare-detail-list {
  padding: 0 18rpx;
}

.compare-detail-card {
  margin-bottom: 14rpx;
}

.compare-detail-card:last-child {
  margin-bottom: 0;
}

.ai-story-panel {
  background: #FFFDF7;
  border: 1rpx solid #F2D7A0;
  border-radius: 12rpx;
  padding: 20rpx;
}

.ai-story-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.ai-guide {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
}

.ai-mascot {
  width: 104rpx;
  height: 128rpx;
  flex-shrink: 0;
}

.ai-mascot-img {
  width: 104rpx;
  height: 128rpx;
  display: block;
}

.ai-story-title {
  color: #1A1A1A;
  font-size: 26rpx;
  font-weight: 600;
}

.ai-story-sub {
  color: #64748B;
  font-size: 20rpx;
  margin-top: 4rpx;
}

.ai-story-btn {
  margin: 0;
  padding: 0 18rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 8rpx;
  background: #1D4ED8;
  color: #FFFFFF;
  font-size: 22rpx;
  flex-shrink: 0;
}

.ai-story-content {
  margin-top: 16rpx;
}

.ai-story-bubble {
  position: relative;
  background: #FFFFFF;
  border: 1rpx solid #F4E4BF;
  border-radius: 12rpx;
  padding: 18rpx;
}

.ai-story-topic {
  color: #92400E;
  font-size: 24rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.ai-story-text {
  color: #334155;
  font-size: 25rpx;
  line-height: 1.7;
}

.ai-ask {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #ECECEA;
}

.ai-ask-title {
  font-size: 23rpx;
  color: #64748B;
  margin-bottom: 12rpx;
}

.ai-ask-row {
  display: flex;
  align-items: center;
}

.ai-ask-input {
  flex: 1;
  height: 64rpx;
  padding: 0 20rpx;
  background: #F5F5F3;
  border-radius: 10rpx;
  font-size: 25rpx;
  color: #1A1A1A;
}

.ai-ask-btn {
  margin-left: 14rpx;
  background: #1A1A1A;
  color: #FFFFFF;
  font-size: 23rpx;
}

.ai-ask-answer {
  margin-top: 14rpx;
  padding: 16rpx 18rpx;
  background: #F8FAFC;
  border-radius: 12rpx;
}

.ai-ask-q {
  font-size: 22rpx;
  color: #94A3B8;
  margin-bottom: 8rpx;
}

.ai-ask-a {
  font-size: 25rpx;
  color: #334155;
  line-height: 1.7;
}

/* Stages timeline */

.stages {
  margin-top: 32rpx;
}

.stage-card {
  position: relative;
  background: #FFFFFF;
  border: 1rpx solid #ECECEA;
  border-radius: 14rpx;
  padding: 24rpx 24rpx 24rpx 64rpx;
  margin-bottom: 16rpx;
}

.stage-rail {
  position: absolute;
  left: 32rpx;
  top: 40rpx;
  bottom: -16rpx;
  width: 2rpx;
  background: #ECECEA;
}

.stage-card:last-child .stage-rail {
  display: none;
}

.stage-dot {
  position: absolute;
  left: 24rpx;
  top: 32rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #FFFFFF;
  border: 3rpx solid #2563EB;
  box-sizing: border-box;
}

.stage-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.stage-index {
  color: #2563EB;
  font-size: 24rpx;
  font-weight: 600;
}

.stage-title {
  flex: 1;
}

.stage-name {
  color: #1A1A1A;
  font-size: 28rpx;
  font-weight: 600;
}

.stage-period {
  margin-top: 4rpx;
  color: #A0A0A0;
  font-size: 20rpx;
}

.stage-glyph {
  margin-top: 14rpx;
  height: 220rpx;
  background: #FAFAF8;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 140rpx;
  color: #1A1A1A;
  font-weight: 500;
  letter-spacing: 4rpx;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}

/* Era-specific typography. Each era uses a CSS font-family that matches a
   wx.loadFontFace registration in utils/historicalFonts.js. When the
   historical font isn't loaded, the modern character still renders with
   the fallback list — same character, different visual emphasis. */

.stage-glyph.era-oracle {
  font-family: 'shuowen-oracle', "STKaiti", "Kaiti SC", serif;
  font-weight: 400;
  color: #2D2D2D;
  letter-spacing: 6rpx;
  background: #FAF7F2;
  /* hand-incised feel via thinner default rendering */
}

.stage-glyph.era-bronze {
  font-family: 'shuowen-bronze', "STKaiti", serif;
  font-weight: 500;
  color: #2D2D2D;
  letter-spacing: 4rpx;
  background: #F7F4ED;
}

.stage-glyph.era-seal {
  font-family: 'shuowen-seal', "STSong", "Songti SC", serif;
  font-weight: 400;
  color: #1A1A1A;
  letter-spacing: 8rpx;
  background: #FAFAF8;
}

.stage-glyph.era-clerical {
  font-family: 'shuowen-clerical', "STLiti", "Lishu", serif;
  font-weight: 500;
  color: #1A1A1A;
  letter-spacing: 2rpx;
}

.stage-glyph.era-regular {
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  font-weight: 500;
  color: #1A1A1A;
  letter-spacing: 0;
}

.stage-desc {
  margin-top: 14rpx;
  color: #6B6B6B;
  font-size: 24rpx;
  line-height: 1.65;
}

.stage-asset-wrap {
  position: relative;
  overflow: hidden;
}

.stage-asset {
  width: 190rpx;
  height: 190rpx;
}

.asset-source {
  margin-top: 10rpx;
  color: #9A7A2F;
  font-size: 21rpx;
  line-height: 1.5;
}

/* Suggest chips in empty state */

.suggest-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
  justify-content: center;
}

/* Char nav bar */

.char-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F0EE;
}

.char-nav-btn {
  font-size: 24rpx;
  color: #2563EB;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background: #EFF6FF;
}

.char-nav-btn:active {
  background: #DBEAFE;
}

.char-nav-btn.disabled {
  color: #C0C0BE;
  background: #F5F5F3;
}

.char-nav-pos {
  font-size: 22rpx;
  color: #A0A0A0;
}

/* Oracle SVG rendering */

.oracle-svg-wrap {
  position: relative;
  flex-direction: column;
  gap: 0;
}

.oracle-svg {
  width: 160rpx;
  height: 160rpx;
}

.oracle-char-sub {
  font-size: 22rpx;
  color: #A0A0A0;
  margin-top: 6rpx;
}

/* Font-size setting (我的 → 字号): scales the main reading text */
.fs-small .current-meaning { font-size: 22rpx; }
.fs-small .stage-name { font-size: 24rpx; }
.fs-small .stage-desc { font-size: 20rpx; }
.fs-small .ai-story-text,
.fs-small .ai-ask-a { font-size: 22rpx; }

.fs-large .current-meaning { font-size: 32rpx; }
.fs-large .stage-name { font-size: 34rpx; }
.fs-large .stage-desc { font-size: 30rpx; }
.fs-large .ai-story-text,
.fs-large .ai-ask-a { font-size: 31rpx; }
