/* Search card */

.search-row {
  position: relative;
  display: flex;
  align-items: center;
}

.search-input {
  flex: 1;
  height: 96rpx;
  padding: 0 84rpx 0 24rpx;
  border-radius: 12rpx;
  border: 1rpx solid #ECECEA;
  background: #FAFAF8;
  font-size: 40rpx;
  font-weight: 600;
  color: #1A1A1A;
  letter-spacing: 4rpx;
  box-sizing: border-box;
}

.search-placeholder {
  color: #C0C0BE;
  font-size: 28rpx;
  font-weight: 400;
  letter-spacing: 0;
}

.search-icon {
  position: absolute;
  right: 24rpx;
  color: #A0A0A0;
  font-size: 28rpx;
  padding: 8rpx;
}

.search-hint {
  color: #C0C0BE;
  font-size: 20rpx;
  margin-top: 10rpx;
}

.history-row {
  margin-top: 20rpx;
}

.history-label {
  color: #A0A0A0;
  font-size: 22rpx;
  margin-bottom: 10rpx;
  letter-spacing: 1rpx;
}

.history-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

/* AI feature group */

.ai-feature-card {
  background: #FFFFFF;
  border: 1rpx solid #ECECEA;
  border-radius: 14rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.card + .ai-feature-card,
.ai-feature-card + .card {
  margin-top: 20rpx;
}

.ai-feature-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.ai-feature-title {
  color: #1A1A1A;
  font-size: 30rpx;
  font-weight: 700;
}

.ai-feature-sub {
  color: #64748B;
  font-size: 22rpx;
  margin-top: 4rpx;
}

.ai-feature-toggle {
  color: #2563EB;
  font-size: 24rpx;
  font-weight: 500;
  flex-shrink: 0;
}

/* Daily AI recommendation */

.daily-card {
  background: #FFFFFF;
  border: 1rpx solid #E8E2D4;
  border-radius: 14rpx;
  padding: 24rpx;
  box-sizing: border-box;
  margin-top: 18rpx;
}

.card + .daily-card,
.daily-card + .card {
  margin-top: 20rpx;
}

.daily-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.daily-kicker {
  color: #9A6A12;
  font-size: 21rpx;
  font-weight: 600;
}

.daily-title {
  color: #1A1A1A;
  font-size: 31rpx;
  font-weight: 700;
  margin-top: 4rpx;
}

.daily-loading {
  height: 168rpx;
  border-radius: 12rpx;
  margin-top: 18rpx;
}

.daily-body {
  display: flex;
  gap: 20rpx;
  margin-top: 18rpx;
}

.daily-glyph {
  width: 132rpx;
  height: 132rpx;
  border-radius: 12rpx;
  background: #FFFDF7;
  border: 1rpx solid #F1D99D;
  color: #1A1A1A;
  font-size: 84rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.daily-main {
  flex: 1;
  min-width: 0;
}

.daily-meta {
  color: #9A6A12;
  font-size: 23rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.daily-insight {
  color: #334155;
  font-size: 24rpx;
  line-height: 1.65;
}

.daily-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 16rpx;
}

.daily-btn {
  margin: 0;
  padding: 0 18rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 8rpx;
  background: #1D4ED8;
  color: #FFFFFF;
  font-size: 22rpx;
  flex-shrink: 0;
}

/* AI quiz */

.quiz-card {
  background: #FFFFFF;
  border: 1rpx solid #E4E8F0;
  border-radius: 14rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.daily-card + .quiz-card,
.quiz-card + .card {
  margin-top: 20rpx;
}

.quiz-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.quiz-kicker {
  color: #2563EB;
  font-size: 21rpx;
  font-weight: 600;
}

.quiz-title {
  color: #1A1A1A;
  font-size: 31rpx;
  font-weight: 700;
  margin-top: 4rpx;
}

.quiz-next,
.quiz-detail-btn {
  margin: 0;
  padding: 0 18rpx;
  height: 52rpx;
  line-height: 52rpx;
  border-radius: 8rpx;
  background: #EFF6FF;
  color: #2563EB;
  font-size: 22rpx;
  flex-shrink: 0;
}

.quiz-loading {
  height: 300rpx;
  border-radius: 12rpx;
  margin-top: 18rpx;
}

.quiz-body {
  margin-top: 18rpx;
}

.quiz-stage {
  color: #64748B;
  font-size: 22rpx;
  margin-bottom: 10rpx;
}

.quiz-glyph-panel {
  height: 280rpx;
  border-radius: 12rpx;
  background: #FAFAF8;
  border: 1rpx solid #ECECEA;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.quiz-glyph-img {
  width: 230rpx;
  height: 230rpx;
}

.quiz-glyph-text {
  color: #1A1A1A;
  font-size: 138rpx;
  font-weight: 600;
}

.quiz-options {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-top: 18rpx;
}

.quiz-option {
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 10rpx;
  background: #F5F5F3;
  border: 1rpx solid #ECECEA;
  color: #1A1A1A;
  font-size: 34rpx;
  font-weight: 600;
}

.quiz-option:active {
  background: #EFF6FF;
  border-color: #BFDBFE;
}

.quiz-option.correct {
  background: #ECFDF5;
  border-color: #86EFAC;
  color: #047857;
}

.quiz-option.wrong {
  background: #FEF2F2;
  border-color: #FECACA;
  color: #B91C1C;
}

.quiz-result {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 12rpx;
  background: #FFFDF7;
  border: 1rpx solid #F2D7A0;
}

.quiz-result-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.quiz-result-title {
  color: #92400E;
  font-size: 25rpx;
  font-weight: 700;
}

.quiz-explaining {
  color: #64748B;
  font-size: 23rpx;
  margin-top: 14rpx;
}

.quiz-explain-row {
  display: flex;
  gap: 14rpx;
  margin-top: 14rpx;
}

.quiz-mascot {
  width: 78rpx;
  height: 96rpx;
  flex-shrink: 0;
}

.quiz-explain-text {
  color: #334155;
  font-size: 24rpx;
  line-height: 1.65;
  flex: 1;
}

.assistant-fab {
  position: fixed;
  right: 28rpx;
  bottom: 168rpx;
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: #FFFDF7;
  border: 1rpx solid #F2D7A0;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 20;
}

.assistant-fab-img {
  width: 70rpx;
  height: 84rpx;
}

/* Stroke filter */

.catalog-toggle-row {
  margin-bottom: 0;
}

.catalog-toggle {
  color: #2563EB;
  font-size: 24rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.catalog-preview {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #FAFAF8;
  border: 1rpx solid #ECECEA;
}

.catalog-preview-text {
  color: #6B6B6B;
  font-size: 22rpx;
  line-height: 1.5;
}

.catalog-preview-chars {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 12rpx;
  overflow: hidden;
  white-space: nowrap;
}

.catalog-preview-char {
  width: 42rpx;
  height: 42rpx;
  line-height: 42rpx;
  text-align: center;
  border-radius: 8rpx;
  background: #FFFFFF;
  border: 1rpx solid #ECECEA;
  color: #1A1A1A;
  font-size: 26rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.stroke-filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.stroke-chip {
  font-size: 22rpx;
  color: #6B6B6B;
  padding: 6rpx 18rpx;
  background: #F5F5F3;
  border-radius: 999rpx;
  border: 1rpx solid transparent;
}

.stroke-chip-active {
  background: #EFF6FF;
  color: #2563EB;
  border-color: #BFDBFE;
  font-weight: 500;
}

/* Catalog */

.catalog-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 10rpx;
  margin-top: 4rpx;
}

.catalog-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx 4rpx;
  background: #F5F5F3;
  border-radius: 10rpx;
  color: #6B6B6B;
  transition: background 0.15s ease, color 0.15s ease;
}

.catalog-pinyin {
  font-size: 16rpx;
  color: #C0C0BE;
  letter-spacing: 0;
  margin-top: 2rpx;
  overflow: hidden;
  white-space: nowrap;
}

.catalog-cell.has-detail {
  background: #FFFFFF;
  border: 1rpx solid #ECECEA;
  color: #1A1A1A;
}

.catalog-cell:active {
  background: #EFF6FF;
  color: #2563EB;
}

.catalog-char {
  font-size: 36rpx;
  font-weight: 500;
}

/* Current character */

.current-card {
  padding: 32rpx 24rpx;
}

.current-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.current-glyph {
  width: 160rpx;
  height: 160rpx;
  border-radius: 14rpx;
  background: #F5F5F3;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 100rpx;
  font-weight: 600;
  color: #1A1A1A;
  flex-shrink: 0;
}

.current-meta {
  flex: 1;
  min-width: 0;
}

.current-pinyin {
  color: #2563EB;
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  margin-bottom: 4rpx;
}

.current-radical {
  color: #6B6B6B;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.current-strokes {
  color: #A0A0A0;
  font-size: 22rpx;
  margin-left: 8rpx;
}

.current-meaning {
  color: #1A1A1A;
  font-size: 26rpx;
  line-height: 1.55;
}

.bookmark-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #FAFAF8;
  border: 1rpx solid #ECECEA;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #C0C0BE;
  font-size: 32rpx;
  flex-shrink: 0;
}

.bookmark-btn.on {
  background: #FFF7E8;
  border-color: #F5C770;
  color: #D97706;
}

/* Compare strip */

.compare-strip {
  background: #FAFAF8;
  border: 1rpx solid #ECECEA;
  border-radius: 12rpx;
  padding: 18rpx 0 16rpx;
}

.compare-head {
  padding: 0 18rpx 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.compare-toggle {
  color: #2563EB;
  font-size: 24rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.compare-title {
  color: #1A1A1A;
  font-size: 26rpx;
  font-weight: 600;
}

.compare-sub {
  color: #A0A0A0;
  font-size: 20rpx;
  margin-top: 4rpx;
  line-height: 1.4;
}

.compare-scroll {
  width: 100%;
  white-space: nowrap;
}

.compare-track {
  display: inline-flex;
  align-items: stretch;
  padding: 0 18rpx;
}

.compare-stage-wrap {
  display: inline-flex;
  align-items: center;
}

.compare-stage {
  width: 116rpx;
  min-height: 176rpx;
  background: #FFFFFF;
  border: 1rpx solid #ECECEA;
  border-radius: 12rpx;
  padding: 10rpx 8rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.compare-arrow {
  width: 30rpx;
  text-align: center;
  color: #A0A0A0;
  font-size: 34rpx;
  font-weight: 600;
}

.compare-glyph-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 10rpx;
  background: #FFFDF7;
  border: 1rpx solid #F4E4BF;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.compare-img {
  width: 88rpx;
  height: 88rpx;
}

.compare-char {
  font-size: 56rpx;
  color: #1A1A1A;
  line-height: 1;
}

.compare-label {
  color: #1A1A1A;
  font-size: 21rpx;
  font-weight: 600;
  margin-top: 10rpx;
}

.compare-detail-list {
  padding: 0 18rpx;
}

.compare-detail-card {
  margin-bottom: 14rpx;
}

.compare-detail-card:last-child {
  margin-bottom: 0;
}

.ai-story-panel {
  background: #FFFDF7;
  border: 1rpx solid #F2D7A0;
  border-radius: 12rpx;
  padding: 20rpx;
}

.ai-story-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.ai-guide {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
}

.ai-mascot {
  width: 104rpx;
  height: 128rpx;
  flex-shrink: 0;
}

.ai-mascot-img {
  width: 104rpx;
  height: 128rpx;
  display: block;
}

.ai-story-title {
  color: #1A1A1A;
  font-size: 26rpx;
  font-weight: 600;
}

.ai-story-sub {
  color: #64748B;
  font-size: 20rpx;
  margin-top: 4rpx;
}

.ai-story-btn {
  margin: 0;
  padding: 0 18rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 8rpx;
  background: #1D4ED8;
  color: #FFFFFF;
  font-size: 22rpx;
  flex-shrink: 0;
}

.ai-story-content {
  margin-top: 16rpx;
}

.ai-story-bubble {
  position: relative;
  background: #FFFFFF;
  border: 1rpx solid #F4E4BF;
  border-radius: 12rpx;
  padding: 18rpx;
}

.ai-story-topic {
  color: #92400E;
  font-size: 24rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.ai-story-text {
  color: #334155;
  font-size: 25rpx;
  line-height: 1.7;
}

.ai-story-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 14rpx;
}

.ai-voice-btn {
  height: 46rpx;
  line-height: 46rpx;
  padding: 0 18rpx;
  border-radius: 8rpx;
  background: #FEF3C7;
  color: #92400E;
  font-size: 22rpx;
  font-weight: 500;
}

.ai-voice-stop {
  background: #FEE2E2;
  color: #B91C1C;
}

/* Stages timeline */

.stages {
  margin-top: 32rpx;
}

.stage-card {
  position: relative;
  background: #FFFFFF;
  border: 1rpx solid #ECECEA;
  border-radius: 14rpx;
  padding: 24rpx 24rpx 24rpx 64rpx;
  margin-bottom: 16rpx;
}

.stage-rail {
  position: absolute;
  left: 32rpx;
  top: 40rpx;
  bottom: -16rpx;
  width: 2rpx;
  background: #ECECEA;
}

.stage-card:last-child .stage-rail {
  display: none;
}

.stage-dot {
  position: absolute;
  left: 24rpx;
  top: 32rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #FFFFFF;
  border: 3rpx solid #2563EB;
  box-sizing: border-box;
}

.stage-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.stage-index {
  color: #2563EB;
  font-size: 24rpx;
  font-weight: 600;
}

.stage-title {
  flex: 1;
}

.stage-name {
  color: #1A1A1A;
  font-size: 28rpx;
  font-weight: 600;
}

.stage-period {
  margin-top: 4rpx;
  color: #A0A0A0;
  font-size: 20rpx;
}

.stage-glyph {
  margin-top: 14rpx;
  height: 220rpx;
  background: #FAFAF8;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 140rpx;
  color: #1A1A1A;
  font-weight: 500;
  letter-spacing: 4rpx;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}

/* Era-specific typography. Each era uses a CSS font-family that matches a
   wx.loadFontFace registration in utils/historicalFonts.js. When the
   historical font isn't loaded, the modern character still renders with
   the fallback list — same character, different visual emphasis. */

.stage-glyph.era-oracle {
  font-family: 'shuowen-oracle', "STKaiti", "Kaiti SC", serif;
  font-weight: 400;
  color: #2D2D2D;
  letter-spacing: 6rpx;
  background: #FAF7F2;
  /* hand-incised feel via thinner default rendering */
}

.stage-glyph.era-bronze {
  font-family: 'shuowen-bronze', "STKaiti", serif;
  font-weight: 500;
  color: #2D2D2D;
  letter-spacing: 4rpx;
  background: #F7F4ED;
}

.stage-glyph.era-seal {
  font-family: 'shuowen-seal', "STSong", "Songti SC", serif;
  font-weight: 400;
  color: #1A1A1A;
  letter-spacing: 8rpx;
  background: #FAFAF8;
}

.stage-glyph.era-clerical {
  font-family: 'shuowen-clerical', "STLiti", "Lishu", serif;
  font-weight: 500;
  color: #1A1A1A;
  letter-spacing: 2rpx;
}

.stage-glyph.era-regular {
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  font-weight: 500;
  color: #1A1A1A;
  letter-spacing: 0;
}

.stage-desc {
  margin-top: 14rpx;
  color: #6B6B6B;
  font-size: 24rpx;
  line-height: 1.65;
}

.stage-asset-wrap {
  position: relative;
  overflow: hidden;
}

.stage-asset {
  width: 190rpx;
  height: 190rpx;
}

.asset-source {
  margin-top: 10rpx;
  color: #9A7A2F;
  font-size: 21rpx;
  line-height: 1.5;
}

/* Suggest chips in empty state */

.suggest-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
  justify-content: center;
}

/* Char nav bar */

.char-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F0EE;
}

.char-nav-btn {
  font-size: 24rpx;
  color: #2563EB;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background: #EFF6FF;
}

.char-nav-btn:active {
  background: #DBEAFE;
}

.char-nav-btn.disabled {
  color: #C0C0BE;
  background: #F5F5F3;
}

.char-nav-pos {
  font-size: 22rpx;
  color: #A0A0A0;
}

/* Oracle SVG rendering */

.oracle-svg-wrap {
  position: relative;
  flex-direction: column;
  gap: 0;
}

.oracle-svg {
  width: 160rpx;
  height: 160rpx;
}

.oracle-char-sub {
  font-size: 22rpx;
  color: #A0A0A0;
  margin-top: 6rpx;
}
