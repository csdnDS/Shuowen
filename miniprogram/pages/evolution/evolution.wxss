/* Search card */

.search-row {
  position: relative;
  display: flex;
  align-items: center;
}

.search-input {
  flex: 1;
  height: 96rpx;
  padding: 0 84rpx 0 24rpx;
  border-radius: 12rpx;
  border: 1rpx solid #ECECEA;
  background: #FAFAF8;
  font-size: 40rpx;
  font-weight: 600;
  color: #1A1A1A;
  letter-spacing: 4rpx;
  box-sizing: border-box;
}

.search-placeholder {
  color: #C0C0BE;
  font-size: 28rpx;
  font-weight: 400;
  letter-spacing: 0;
}

.search-icon {
  position: absolute;
  right: 24rpx;
  color: #A0A0A0;
  font-size: 28rpx;
  padding: 8rpx;
}

.search-hint {
  color: #C0C0BE;
  font-size: 20rpx;
  margin-top: 10rpx;
}

.history-row {
  margin-top: 20rpx;
}

.history-label {
  color: #A0A0A0;
  font-size: 22rpx;
  margin-bottom: 10rpx;
  letter-spacing: 1rpx;
}

.history-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

/* Catalog */

.catalog-grid {
  display: grid;
  grid-template-columns: repeat(8, 1fr);
  gap: 12rpx;
  margin-top: 4rpx;
}

.catalog-cell {
  display: flex;
  align-items: center;
  justify-content: center;
  aspect-ratio: 1 / 1;
  background: #F5F5F3;
  border-radius: 10rpx;
  font-size: 32rpx;
  color: #6B6B6B;
  transition: background 0.15s ease, color 0.15s ease;
}

.catalog-cell.has-detail {
  background: #FFFFFF;
  border: 1rpx solid #ECECEA;
  color: #1A1A1A;
}

.catalog-cell:active {
  background: #EFF6FF;
  color: #2563EB;
}

.catalog-char {
  font-weight: 500;
}

/* Current character */

.current-card {
  padding: 32rpx 24rpx;
}

.current-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.current-glyph {
  width: 160rpx;
  height: 160rpx;
  border-radius: 14rpx;
  background: #F5F5F3;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 100rpx;
  font-weight: 600;
  color: #1A1A1A;
  flex-shrink: 0;
}

.current-meta {
  flex: 1;
  min-width: 0;
}

.current-pinyin {
  color: #2563EB;
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  margin-bottom: 4rpx;
}

.current-radical {
  color: #6B6B6B;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.current-strokes {
  color: #A0A0A0;
  font-size: 22rpx;
  margin-left: 8rpx;
}

.current-meaning {
  color: #1A1A1A;
  font-size: 26rpx;
  line-height: 1.55;
}

.bookmark-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #FAFAF8;
  border: 1rpx solid #ECECEA;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #C0C0BE;
  font-size: 32rpx;
  flex-shrink: 0;
}

.bookmark-btn.on {
  background: #FFF7E8;
  border-color: #F5C770;
  color: #D97706;
}

/* Stages timeline */

.stages {
  margin-top: 32rpx;
}

.stage-card {
  position: relative;
  background: #FFFFFF;
  border: 1rpx solid #ECECEA;
  border-radius: 14rpx;
  padding: 24rpx 24rpx 24rpx 64rpx;
  margin-bottom: 16rpx;
}

.stage-rail {
  position: absolute;
  left: 32rpx;
  top: 40rpx;
  bottom: -16rpx;
  width: 2rpx;
  background: #ECECEA;
}

.stage-card:last-child .stage-rail {
  display: none;
}

.stage-dot {
  position: absolute;
  left: 24rpx;
  top: 32rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #FFFFFF;
  border: 3rpx solid #2563EB;
  box-sizing: border-box;
}

.stage-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.stage-index {
  color: #2563EB;
  font-size: 24rpx;
  font-weight: 600;
}

.stage-name {
  flex: 1;
  color: #1A1A1A;
  font-size: 28rpx;
  font-weight: 600;
}

.stage-copy {
  font-size: 22rpx;
  color: #6B6B6B;
  padding: 6rpx 14rpx;
  background: #F5F5F3;
  border-radius: 6rpx;
}

.stage-copy:active {
  background: #EFF6FF;
  color: #2563EB;
}

.stage-glyph {
  margin-top: 14rpx;
  height: 220rpx;
  background: #FAFAF8;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 140rpx;
  color: #1A1A1A;
  font-weight: 500;
  letter-spacing: 4rpx;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}

/* Era-specific typography. Each era uses a CSS font-family that matches a
   wx.loadFontFace registration in utils/historicalFonts.js. When the
   historical font isn't loaded, the modern character still renders with
   the fallback list — same character, different visual emphasis. */

.stage-glyph.era-oracle {
  font-family: 'shuowen-oracle', "STKaiti", "Kaiti SC", serif;
  font-weight: 400;
  color: #2D2D2D;
  letter-spacing: 6rpx;
  background: #FAF7F2;
  /* hand-incised feel via thinner default rendering */
}

.stage-glyph.era-bronze {
  font-family: 'shuowen-bronze', "STKaiti", serif;
  font-weight: 500;
  color: #2D2D2D;
  letter-spacing: 4rpx;
  background: #F7F4ED;
}

.stage-glyph.era-seal {
  font-family: 'shuowen-seal', "STSong", "Songti SC", serif;
  font-weight: 400;
  color: #1A1A1A;
  letter-spacing: 8rpx;
  background: #FAFAF8;
}

.stage-glyph.era-clerical {
  font-family: 'shuowen-clerical', "STLiti", "Lishu", serif;
  font-weight: 500;
  color: #1A1A1A;
  letter-spacing: 2rpx;
}

.stage-glyph.era-regular {
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  font-weight: 500;
  color: #1A1A1A;
  letter-spacing: 0;
}

.stage-desc {
  margin-top: 14rpx;
  color: #6B6B6B;
  font-size: 24rpx;
  line-height: 1.65;
}
