<view class="page">

  <!-- Page header -->
  <view class="page-header">
    <view class="eyebrow">CHAR EVOLUTION</view>
    <view class="page-title">字形演变</view>
    <view class="page-subtitle">从甲骨、金文到楷书，追溯一个汉字的五段形体。</view>
  </view>

  <!-- Offline banner -->
  <view wx:if="{{offline}}" class="banner banner-info mb-md">
    <text>当前未连接到本地服务，显示离线示例数据。</text>
  </view>

  <!-- Search card -->
  <view class="card">
    <view class="search-row">
      <input class="search-input" maxlength="10" value="{{query}}" bindinput="onInput" placeholder="汉字 或 拼音（如 shui）" placeholder-class="search-placeholder" />
      <view class="search-icon" bindtap="randomChar">🎲</view>
    </view>
    <view class="search-hint">支持拼音检索，点击 🎲 随机一字</view>

    <view wx:if="{{hasSearchHistory}}" class="history-row">
      <view class="history-label">最近搜索</view>
      <view class="history-chips">
        <view wx:for="{{searchHistory}}" wx:key="*this" class="chip" data-char="{{item}}" bindtap="useHistory">{{item}}</view>
        <view class="chip chip-outline" bindtap="clearHistory">清空</view>
      </view>
    </view>
  </view>

  <!-- Catalog card -->
  <view class="card">
    <view class="section-row">
      <view>
        <view class="section-title">字库索引</view>
        <view class="section-sub">共 {{catalogTotal}} 字 · 展示 {{catalogReturned}}</view>
      </view>
    </view>
    <!-- Stroke filter chips -->
    <view class="stroke-filter-row">
      <view wx:for="{{strokeOptions}}" wx:key="value"
            class="stroke-chip {{strokeFilter === item.value ? 'stroke-chip-active' : ''}}"
            data-value="{{item.value}}" bindtap="setStrokeFilter">{{item.label}}</view>
    </view>
    <view class="catalog-grid">
      <view wx:for="{{catalogFiltered}}" wx:key="char" class="catalog-cell {{item.hasDetail ? 'has-detail' : ''}}" data-char="{{item.char}}" bindtap="useCatalog">
        <text class="catalog-char">{{item.char}}</text>
        <text wx:if="{{item.pinyin}}" class="catalog-pinyin">{{item.pinyin}}</text>
      </view>
    </view>
  </view>

  <!-- Current character card -->
  <view wx:if="{{loading}}" class="card current-card">
    <view class="loading-shimmer" style="height:200rpx; border-radius:12rpx"></view>
  </view>

  <view wx:elif="{{character}}" class="card current-card">
    <view class="current-row">
      <view class="current-glyph">{{character.char}}</view>
      <view class="current-meta">
        <view wx:if="{{character.pinyin}}" class="current-pinyin">{{character.pinyin}}</view>
        <view wx:if="{{character.radical}}" class="current-radical">部首 · {{character.radical}}<text wx:if="{{character.strokes}}" class="current-strokes">  {{character.strokes}} 画</text></view>
        <view class="current-meaning">{{character.meaning}}</view>
      </view>
      <view class="bookmark-btn {{bookmarked ? 'on' : ''}}" bindtap="toggleBookmark">
        <text>{{bookmarked ? '★' : '☆'}}</text>
      </view>
    </view>
    <view class="char-nav mt-sm">
      <view class="char-nav-btn {{hasPrev ? '' : 'disabled'}}" bindtap="prevChar">‹ 上一字</view>
      <view class="char-nav-pos">{{catalogIndex >= 0 ? catalogIndex + 1 : '-'}} / {{catalogReturned}}</view>
      <view class="char-nav-btn {{hasNext ? '' : 'disabled'}}" bindtap="nextChar">下一字 ›</view>
    </view>
  </view>

  <view wx:else class="card empty">
    <view class="empty-icon">字</view>
    <view class="empty-title">未找到该字</view>
    <view class="empty-body">可输入汉字或拼音检索（如 shui / 水）。常用示例：</view>
    <view class="suggest-row">
      <view wx:for="{{suggestChars}}" wx:key="*this" class="chip" data-char="{{item}}" bindtap="useCatalog">{{item}}</view>
    </view>
  </view>

  <!-- Related characters -->
  <view wx:if="{{related.length > 0}}" class="card">
    <view class="section-row">
      <view>
        <view class="section-title">同部首汉字</view>
        <view class="section-sub">{{character.radical}}部</view>
      </view>
    </view>
    <view class="catalog-grid">
      <view wx:for="{{related}}" wx:key="char" class="catalog-cell has-detail" data-char="{{item.char}}" bindtap="useCatalog">
        <text class="catalog-char">{{item.char}}</text>
      </view>
    </view>
  </view>

  <!-- Stages timeline -->
  <view wx:if="{{character && character.stages.length > 0}}" class="stages">
    <view class="section-title mb-md" style="padding-left:8rpx">五段形体</view>
    <view wx:for="{{character.stages}}" wx:key="name" class="stage-card">
      <view class="stage-rail"></view>
      <view class="stage-dot"></view>

      <view class="stage-body">
        <view class="stage-head">
          <view class="stage-index">{{item.indexLabel}}</view>
          <view class="stage-name">{{item.label}}</view>
          <view class="stage-copy" data-glyph="{{item.glyph}}" catchtap="copyGlyph">复制</view>
        </view>
        <view wx:if="{{item.oracleSrc}}" class="stage-glyph era-oracle oracle-svg-wrap">
          <image class="oracle-svg" src="{{item.oracleSrc}}" mode="aspectFit"></image>
          <view class="oracle-char-sub">{{item.glyph}}</view>
        </view>
        <view wx:else class="stage-glyph era-{{item.era}}">{{item.glyph}}</view>
        <view wx:if="{{item.desc || item.description}}" class="stage-desc">{{item.desc || item.description}}</view>
      </view>
    </view>
  </view>

</view>
