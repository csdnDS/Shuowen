<view class="page {{pageClass}}">

  <!-- Page header -->
  <view class="page-header">
    <view class="eyebrow">CHAR EVOLUTION</view>
    <view class="page-title">字形演变</view>
    <view class="page-subtitle">从甲骨、金文到楷书，追溯一个汉字的五段形体。</view>
  </view>

  <!-- Offline banner -->
  <view wx:if="{{offline}}" class="banner banner-info mb-md">
    <text>当前未连接到本地服务，显示离线示例数据。</text>
  </view>

  <view class="search-launcher" bindtap="openSearchPanel">
    <view class="search-launcher-main">
      <view class="search-launcher-icon">⌕</view>
      <view>
        <view class="search-launcher-title">搜索汉字</view>
        <view class="search-launcher-sub">支持汉字和拼音</view>
      </view>
    </view>
  </view>

  <!-- AI feature group -->
  <view id="ai-feature-panel" class="ai-feature-card">
    <view class="ai-feature-head" bindtap="toggleAiPanel">
      <view>
        <view class="ai-feature-title">小字灵助手</view>
        <view class="ai-feature-sub">每日推荐 · 猜字游戏 · 字源讲解</view>
      </view>
      <view class="ai-feature-toggle">{{aiPanelExpanded ? '收起' : '展开'}} {{aiPanelExpanded ? '⌃' : '⌄'}}</view>
    </view>

    <view wx:if="{{aiPanelExpanded}}">
      <!-- Daily AI recommendation -->
      <view class="daily-card">
        <view class="daily-head">
          <view>
            <view class="daily-kicker">AI 每日一字</view>
            <view class="daily-title">{{dailyRecommendation ? dailyRecommendation.title : '今日汉字推荐'}}</view>
          </view>
        </view>
        <view wx:if="{{dailyLoading}}" class="loading-shimmer daily-loading"></view>
        <view wx:elif="{{dailyRecommendation}}" class="daily-body">
          <view class="daily-glyph">{{dailyRecommendation.char}}</view>
          <view class="daily-main">
            <view class="daily-meta">
              <text wx:if="{{dailyRecommendation.pinyin}}">{{dailyRecommendation.pinyin}}</text>
              <text wx:if="{{dailyRecommendation.radical}}"> · {{dailyRecommendation.radical}}部</text>
            </view>
            <view class="daily-insight">{{dailyRecommendation.insight}}</view>
            <view class="daily-actions">
              <button class="daily-btn" size="mini" bindtap="useDailyRecommendation">查看字形</button>
            </view>
          </view>
        </view>
      </view>

      <!-- AI learning dashboard -->
      <view class="learning-card">
        <view class="learning-head">
          <view>
            <view class="learning-kicker">AI 学习看板</view>
            <view class="learning-title">{{learningPath ? learningPath.title : '个性化学习路径'}}</view>
          </view>
          <button class="learning-refresh" size="mini" loading="{{learningPathLoading}}" bindtap="refreshLearningPath">刷新</button>
        </view>

        <view class="learning-stats">
          <view class="learning-stat">
            <view class="learning-stat-value">{{learningDashboard.unlockedCount}}/{{learningDashboard.coreTotal}}</view>
            <view class="learning-stat-label">核心字进度</view>
          </view>
          <view class="learning-stat">
            <view class="learning-stat-value">{{learningDashboard.quizAccuracy}}%</view>
            <view class="learning-stat-label">猜字正确率</view>
          </view>
          <view class="learning-stat">
            <view class="learning-stat-value">{{learningDashboard.aiInteractions}}</view>
            <view class="learning-stat-label">AI互动</view>
          </view>
        </view>

        <view wx:if="{{learningPathLoading && !learningPath}}" class="loading-shimmer learning-loading"></view>
        <view wx:elif="{{learningPath}}" class="learning-body">
          <view class="learning-summary">{{learningPath.summary}}</view>
          <view class="learning-next-row">
            <view wx:for="{{learningPath.recommendations}}" wx:key="char" class="learning-next" data-char="{{item.char}}" bindtap="usePathRecommendation">
              <view class="learning-next-char">{{item.char}}</view>
              <view class="learning-next-meta">
                <view>{{item.pinyin || '待补音'}}</view>
                <view>{{item.radical ? item.radical + '部' : '部首待补'}}</view>
              </view>
            </view>
          </view>
          <view wx:if="{{learningPath.recommendations.length > 0}}" class="learning-reason">
            {{learningPath.recommendations[0].reason}}
          </view>
        </view>
      </view>

      <!-- AI quiz game -->
      <view class="quiz-card">
        <view class="quiz-head">
          <view>
            <view class="quiz-kicker">AI 猜字游戏</view>
            <view class="quiz-title">这是什么现代汉字？</view>
          </view>
          <button class="quiz-next" size="mini" loading="{{quizLoading}}" bindtap="nextQuiz">换一题</button>
        </view>
        <view wx:if="{{quiz}}" class="quiz-body">
          <view class="quiz-stage">{{quiz.stageLabel}}</view>
          <view class="quiz-glyph-panel">
            <image wx:if="{{quiz.assetUrl}}" class="quiz-glyph-img" src="{{quiz.assetUrl}}" mode="aspectFit"></image>
            <view wx:else class="quiz-glyph-text">{{quiz.char}}</view>
          </view>
          <view class="quiz-options">
            <view wx:for="{{quiz.options}}" wx:key="char"
                  class="quiz-option {{quizAnswered && item.correct ? 'correct' : ''}} {{quizAnswered && item.selected && !item.correct ? 'wrong' : ''}}"
                  data-char="{{item.char}}" bindtap="chooseQuizOption">{{item.char}}</view>
          </view>
          <view wx:if="{{quizAnswered}}" class="quiz-result">
            <view class="quiz-result-head">
              <view>
                <view class="quiz-result-title">{{quizCorrect ? '猜对了' : '答案揭晓'}}</view>
                <view class="quiz-result-sub">{{quizCorrect ? '你抓住了古文字线索' : '再看一次字形线索就会更像了'}}</view>
              </view>
              <view class="quiz-answer-char">{{quiz.char}}</view>
            </view>
            <view class="quiz-answer-meta">
              <text wx:if="{{quiz.pinyin}}">{{quiz.pinyin}}</text>
              <text wx:if="{{quiz.meaning}}"> · {{quiz.meaning}}</text>
            </view>
            <view wx:if="{{quizExplaining}}" class="quiz-explaining">小字灵正在讲解...</view>
            <view wx:elif="{{quizExplanation}}" class="quiz-explain-row">
              <image class="quiz-mascot" src="/assets/mascot/xiao-ziling.png" mode="aspectFit"></image>
              <view class="quiz-explain-main">
                <view wx:if="{{quizExplanation.diagnosis}}" class="quiz-diagnosis">
                  <view class="quiz-diagnosis-label">AI错因分析</view>
                  <view class="quiz-diagnosis-text">{{quizExplanation.diagnosis}}</view>
                </view>
                <view class="quiz-explain-text">{{quizExplanation.narrative || quizExplanation.story}}</view>
              </view>
            </view>
            <view class="quiz-result-actions">
              <button class="quiz-action-primary" size="mini" bindtap="nextQuiz">再来一题</button>
              <button class="quiz-action-secondary" size="mini" bindtap="openQuizCharacter">查看演变</button>
            </view>
          </view>
        </view>
        <view wx:else class="loading-shimmer quiz-loading"></view>
      </view>
    </view>
  </view>

  <!-- Current character card -->
  <view wx:if="{{loading}}" id="current-character-card" class="card current-card">
    <view class="loading-shimmer" style="height:200rpx; border-radius:12rpx"></view>
  </view>

  <view wx:elif="{{character}}" id="current-character-card" class="card current-card">
    <view class="current-row">
      <view class="current-glyph">{{character.char}}</view>
      <view class="current-meta">
        <view wx:if="{{character.pinyin}}" class="current-pinyin">{{character.pinyin}}</view>
        <view wx:if="{{character.radical}}" class="current-radical" bindtap="openRadicalIndex">部首 · {{character.radical}}<text wx:if="{{character.strokes}}" class="current-strokes">  {{character.strokes}} 画</text></view>
        <view class="current-meaning">{{character.meaning}}</view>
      </view>
      <view class="bookmark-btn {{bookmarked ? 'on' : ''}}" bindtap="toggleBookmark">
        <text>{{bookmarked ? '★' : '☆'}}</text>
      </view>
    </view>
    <view class="char-nav mt-sm">
      <view class="char-nav-btn {{hasPrev ? '' : 'disabled'}}" bindtap="prevChar">‹ 上一字</view>
      <view class="char-nav-pos">{{catalogIndex >= 0 ? catalogIndex + 1 : '-'}} / {{catalogReturned}}</view>
      <view class="char-nav-btn {{hasNext ? '' : 'disabled'}}" bindtap="nextChar">下一字 ›</view>
    </view>
    <view wx:if="{{character.stages.length > 0}}" class="compare-strip mt-sm">
      <view class="compare-head" bindtap="toggleCompare">
        <view>
          <view class="compare-title">字形对比</view>
          <view class="compare-sub">{{compareExpanded ? '纵向查看每个阶段的来源、年代与说明' : '甲骨 → 金文 → 篆书 → 隶书 → 楷书'}}</view>
        </view>
        <view class="compare-toggle">{{compareExpanded ? '收起' : '展开'}} {{compareExpanded ? '⌃' : '⌄'}}</view>
      </view>
      <scroll-view wx:if="{{!compareExpanded}}" scroll-x class="compare-scroll" enhanced show-scrollbar="{{false}}">
        <view class="compare-track">
          <view wx:for="{{character.stages}}" wx:key="era" class="compare-stage-wrap">
            <view class="compare-stage">
              <view class="compare-glyph-wrap">
                <image wx:if="{{item.showAsset}}" class="compare-img" src="{{item.assetUrl}}" mode="aspectFit"></image>
                <image wx:elif="{{item.oracleSrc}}" class="compare-img" src="{{item.oracleSrc}}" mode="aspectFit"></image>
                <view wx:else class="compare-char era-{{item.era}}">{{item.displayGlyph || item.glyph}}</view>
              </view>
              <view class="compare-label">{{item.label}}</view>
            </view>
            <view wx:if="{{index < character.stages.length - 1}}" class="compare-arrow">›</view>
          </view>
        </view>
      </scroll-view>
      <view wx:else class="compare-detail-list">
        <view wx:for="{{character.stages}}" wx:key="era" class="stage-card compare-detail-card">
          <view class="stage-rail"></view>
          <view class="stage-dot"></view>

          <view class="stage-body">
            <view class="stage-head">
              <view class="stage-index">{{item.indexLabel}}</view>
              <view class="stage-title">
                <view class="stage-name">{{item.label}}</view>
                <view wx:if="{{item.period}}" class="stage-period">{{item.period}}</view>
              </view>
            </view>
            <view wx:if="{{item.showAsset}}" class="stage-glyph stage-asset-wrap">
              <image class="stage-asset" src="{{item.assetUrl}}" mode="aspectFit"></image>
            </view>
            <view wx:elif="{{item.oracleSrc}}" class="stage-glyph era-oracle oracle-svg-wrap">
              <image class="oracle-svg" src="{{item.oracleSrc}}" mode="aspectFit"></image>
              <view class="oracle-char-sub">{{item.glyph}}</view>
            </view>
            <view wx:else class="stage-glyph era-{{item.era}}">{{item.displayGlyph || item.glyph}}</view>
            <view wx:if="{{item.desc || item.description}}" class="stage-desc">{{item.desc || item.description}}</view>
          </view>
        </view>
      </view>
    </view>
    <view id="ai-story-panel" class="ai-story-panel mt-sm">
      <view class="ai-story-head">
        <view class="ai-guide">
          <view class="ai-mascot">
            <image class="ai-mascot-img" src="/assets/mascot/xiao-ziling.png" mode="aspectFit"></image>
          </view>
          <view>
            <view class="ai-story-title">汉字故事官 · 小字灵</view>
            <view class="ai-story-sub">结合字形数据生成起源小故事</view>
          </view>
        </view>
        <button class="ai-story-btn" size="mini" loading="{{aiStoryLoading}}" bindtap="loadAiStory">
          {{aiStory ? '重新生成' : 'AI讲故事'}}
        </button>
      </view>
      <view wx:if="{{aiStory}}" class="ai-story-content">
        <view class="ai-story-bubble">
          <view class="ai-story-topic">{{aiStory.title}}</view>
          <view class="ai-story-text">{{aiStory.story}}</view>
        </view>
      </view>
    </view>
  </view>

  <view wx:else class="card empty">
    <view class="empty-icon">字</view>
    <view class="empty-title">未找到该字</view>
    <view class="empty-body">可输入汉字或拼音检索（如 shui / 水）。常用示例：</view>
    <view class="suggest-row">
      <view wx:for="{{suggestChars}}" wx:key="*this" class="chip" data-char="{{item}}" bindtap="useCatalog">{{item}}</view>
    </view>
  </view>

  <!-- Catalog card -->
  <view class="card">
    <view class="section-row catalog-toggle-row" bindtap="toggleCatalog">
      <view>
        <view class="section-title">字库索引</view>
        <view class="section-sub">共 {{catalogTotal}} 字 · 展示 {{catalogReturned}}</view>
      </view>
      <view class="catalog-toggle">{{catalogExpanded ? '收起' : '展开'}} {{catalogExpanded ? '⌃' : '⌄'}}</view>
    </view>
    <view wx:if="{{!catalogExpanded}}" class="catalog-preview">
      <view class="catalog-preview-text">点开浏览字库、按笔画筛选，或使用上方搜索入口。</view>
      <view class="catalog-preview-chars">
        <text wx:for="{{suggestChars}}" wx:key="*this" class="catalog-preview-char">{{item}}</text>
      </view>
    </view>
    <view wx:else>
      <!-- Stroke filter chips -->
      <view class="stroke-filter-row">
        <view wx:for="{{strokeOptions}}" wx:key="value"
              class="stroke-chip {{strokeFilter === item.value ? 'stroke-chip-active' : ''}}"
              data-value="{{item.value}}" catchtap="setStrokeFilter">{{item.label}}</view>
      </view>
      <view class="catalog-grid">
        <view wx:for="{{catalogFiltered}}" wx:key="char" class="catalog-cell {{item.hasDetail ? 'has-detail' : ''}}" data-char="{{item.char}}" bindtap="useCatalog">
          <text class="catalog-char">{{item.char}}</text>
          <text wx:if="{{item.pinyin}}" class="catalog-pinyin">{{item.pinyin}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="assistant-fab" bindtap="quickAsk">
    <image class="assistant-fab-img" src="/assets/mascot/xiao-ziling.png" mode="aspectFit"></image>
    <view class="assistant-fab-label">问小字灵</view>
  </view>

  <view wx:if="{{searchPanelVisible}}" class="search-overlay" catchtap="closeSearchPanel">
    <view class="search-sheet" catchtap="noop">
      <view class="search-sheet-head">
        <view>
          <view class="search-sheet-title">查找汉字</view>
          <view class="search-sheet-sub">输入汉字、拼音，或随机看看</view>
        </view>
        <view class="search-sheet-close" bindtap="closeSearchPanel">×</view>
      </view>
      <view class="search-row">
        <input class="search-input" maxlength="10" value="{{query}}" focus="{{searchFocus}}"
               bindinput="onInput" confirm-type="search" bindconfirm="submitSearch"
               placeholder="汉字 或 拼音（如 shui）" placeholder-class="search-placeholder" />
        <view class="search-icon" bindtap="randomChar">🎲</view>
      </view>
      <view class="search-hint">按回车搜索，点击 🎲 随机一字</view>

      <view wx:if="{{showSuggestions}}" class="suggest-dropdown">
        <view wx:for="{{suggestions}}" wx:key="char" class="suggest-item"
              data-char="{{item.char}}" bindtap="useSuggestion">
          <text class="suggest-item-char">{{item.char}}</text>
          <text wx:if="{{item.pinyin}}" class="suggest-item-pinyin">{{item.pinyin}}</text>
        </view>
      </view>

      <view wx:if="{{hasSearchHistory}}" class="history-row">
        <view class="history-label">最近搜索</view>
        <view class="history-chips">
          <view wx:for="{{searchHistory}}" wx:key="*this" class="chip" data-char="{{item}}" bindtap="useHistory">{{item}}</view>
          <view class="chip chip-outline" bindtap="clearHistory">清空</view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{askPanelVisible}}" class="search-overlay" catchtap="closeAskPanel">
    <view class="ask-sheet" catchtap="noop">
      <view class="ask-sheet-head">
        <image class="ask-sheet-mascot" src="/assets/mascot/xiao-ziling.png" mode="aspectFit"></image>
        <view class="ask-sheet-title-wrap">
          <view class="ask-sheet-title">小字灵</view>
          <view class="ask-sheet-sub">汉字字源 · 字形演变 · 部首读音</view>
        </view>
        <view class="search-sheet-close" bindtap="closeAskPanel">×</view>
      </view>

      <view class="ask-message-list">
        <view wx:if="{{askMessages.length === 0}}" class="ask-empty">
          <view>我可以帮你讲字源、比较字形，也可以把复杂解释变成适合展示的短讲稿。</view>
        </view>
        <view wx:for="{{askMessages}}" wx:key="index" class="ask-message {{item.role === 'user' ? 'ask-message-user' : 'ask-message-assistant'}}">
          <view class="ask-bubble">{{item.text}}</view>
        </view>
        <view wx:if="{{askLoading}}" class="ask-message ask-message-assistant">
          <view class="ask-bubble ask-thinking">小字灵正在想...</view>
        </view>
      </view>

      <view class="ask-presets">
        <view class="ask-preset" data-question="这个字的字源是什么？" bindtap="useAskPreset">字源</view>
        <view class="ask-preset" data-question="这个字的甲骨文像什么？" bindtap="useAskPreset">甲骨文</view>
        <view class="ask-preset" data-question="用一句话讲它的演变" bindtap="useAskPreset">一句话</view>
      </view>

      <view class="ai-ask-row">
        <input class="ai-ask-input" maxlength="60" value="{{askInput}}" focus="{{askFocus}}"
               bindinput="onAskInput" confirm-type="send" bindconfirm="submitAsk"
               placeholder="问任意汉字，如「火的字源」" placeholder-class="search-placeholder" />
        <button class="ai-ask-btn" size="mini" loading="{{askLoading}}" bindtap="submitAsk">提问</button>
      </view>
    </view>
  </view>

</view>
