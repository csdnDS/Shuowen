/* User card */

.user-card {
  padding: 24rpx;
}

.user-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.user-meta {
  flex: 1;
  min-width: 0;
}

.user-name {
  color: #1A1A1A;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: -0.2rpx;
}

.user-sub {
  color: #6B6B6B;
  font-size: 24rpx;
  margin-top: 4rpx;
}

/* Stats grid */

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.stat-cell {
  background: #FFFFFF;
  border: 1rpx solid #ECECEA;
  border-radius: 12rpx;
  padding: 20rpx 16rpx;
  text-align: center;
}

.stat-cell .stat-value {
  font-size: 44rpx;
  font-variant-numeric: tabular-nums;
}

.stat-cell .stat-label {
  font-size: 22rpx;
}

/* Level badge */

.level-badge {
  background: #EFF6FF;
  color: #2563EB;
  font-size: 24rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

/* Streak bar */

.streak-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.streak-label {
  color: #6B6B6B;
  font-size: 22rpx;
}

.streak-dots {
  display: flex;
  gap: 10rpx;
}

.streak-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #ECECEA;
}

.dot-on {
  background: #2563EB;
}

/* Bookmarks */

.bookmark-block {
  margin-bottom: 18rpx;
}

.bookmark-block-title {
  color: #6B6B6B;
  font-size: 22rpx;
  margin-bottom: 10rpx;
}

.recent-scroll {
  width: 100%;
  white-space: nowrap;
}

.recent-track {
  display: inline-flex;
  gap: 10rpx;
}

.recent-chip {
  min-width: 92rpx;
  height: 76rpx;
  padding: 8rpx 14rpx;
  border-radius: 12rpx;
  background: #EFF6FF;
  border: 1rpx solid #BFDBFE;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.recent-chip-char {
  color: #1D4ED8;
  font-size: 30rpx;
  font-weight: 700;
}

.recent-chip-pinyin {
  color: #64748B;
  font-size: 17rpx;
  margin-top: 2rpx;
}

.bookmark-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 10rpx;
  margin-top: 4rpx;
}

.bookmark-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx 4rpx;
  background: #FAFAF8;
  border: 1rpx solid #ECECEA;
  border-radius: 10rpx;
  color: #1A1A1A;
}

.bm-char {
  font-size: 36rpx;
  font-weight: 500;
}

.bm-pinyin {
  font-size: 16rpx;
  color: #A0A0A0;
  margin-top: 2rpx;
  overflow: hidden;
  white-space: nowrap;
}

.bookmark-cell:active {
  background: #FFF7E8;
  border-color: #F5C770;
  color: #D97706;
}

.bookmark-groups {
  margin-top: 18rpx;
}

.bookmark-group {
  padding: 16rpx;
  border-radius: 12rpx;
  background: #FAFAF8;
  border: 1rpx solid #ECECEA;
  margin-bottom: 12rpx;
}

.bookmark-group:last-child {
  margin-bottom: 0;
}

.bookmark-group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.bookmark-group-title {
  color: #1A1A1A;
  font-size: 25rpx;
  font-weight: 700;
}

.bookmark-group-count {
  color: #94A3B8;
  font-size: 20rpx;
}

.bookmark-group-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.bookmark-mini {
  width: 54rpx;
  height: 54rpx;
  line-height: 54rpx;
  text-align: center;
  border-radius: 8rpx;
  background: #FFFFFF;
  border: 1rpx solid #ECECEA;
  color: #1A1A1A;
  font-size: 28rpx;
  font-weight: 600;
}
