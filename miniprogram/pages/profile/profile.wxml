<view class="page {{pageClass}}">

  <view class="page-header">
    <view class="eyebrow">USER CENTER</view>
    <view class="page-title">我的</view>
  </view>

  <!-- User card -->
  <view class="user-card card">
    <view wx:if="{{isLoggedIn}}" class="user-row">
      <image wx:if="{{user.avatarUrl}}" class="avatar" src="{{user.avatarUrl}}"></image>
      <view wx:else class="avatar avatar-fallback">{{userInitial}}</view>
      <view class="user-meta">
        <view class="user-name">{{user.nickname}}</view>
        <view class="user-sub">已登录 · 学习数据云同步</view>
      </view>
      <view class="btn btn-sm" bindtap="logout">退出</view>
    </view>

    <view wx:else class="user-row">
      <view class="avatar avatar-fallback">访</view>
      <view class="user-meta">
        <view class="user-name">说文访客</view>
        <view class="user-sub">登录后云端同步学习进度与收藏</view>
      </view>
      <view class="btn btn-primary btn-sm" bindtap="wechatLogin">微信登录</view>
    </view>
  </view>

  <view wx:if="{{offline}}" class="banner banner-info mb-md">
    <text>当前未连接到本地服务，仅展示本地数据。</text>
  </view>

  <!-- Stats grid -->
  <view class="stats-grid">
    <view class="stat-cell">
      <view class="stat-value">{{stats.unlockedCount}}</view>
      <view class="stat-label">已解锁</view>
    </view>
    <view class="stat-cell">
      <view class="stat-value">{{stats.streakDays}}</view>
      <view class="stat-label">连续学习</view>
    </view>
    <view class="stat-cell">
      <view class="stat-value">{{stats.bookmarkCount}}</view>
      <view class="stat-label">已收藏</view>
    </view>
  </view>

  <!-- Progress / level card -->
  <view class="card">
    <view class="section-row">
      <view>
        <view class="section-title">学习等级</view>
        <view class="section-sub">{{levelHint}}</view>
      </view>
      <view class="level-badge">{{levelName}}</view>
    </view>
    <view class="progress mt-sm">
      <view class="progress-fill" style="width: {{progressPercent}}%"></view>
    </view>
    <view class="text-muted mt-sm" style="font-size:22rpx">总进度 {{progressPercent}}% · 共 {{stats.total}} 字</view>

    <!-- Streak bar: last 7 days -->
    <view class="streak-bar mt-md">
      <view class="streak-label">连续学习 {{stats.streakDays}} 天</view>
      <view class="streak-dots">
        <view wx:for="{{7}}" wx:key="*this"
              class="streak-dot {{index < stats.streakDays ? 'dot-on' : ''}}"></view>
      </view>
    </view>
  </view>

  <!-- Bookmarks -->
  <view class="card">
    <view class="section-row">
      <view>
        <view class="section-title">我的收藏</view>
        <view class="section-sub">{{bookmarks.length}} 字 · 按部首整理</view>
      </view>
      <view class="btn btn-ghost btn-sm" bindtap="goEvolution">去添加</view>
    </view>

    <view wx:if="{{hasRecentViews}}" class="bookmark-block">
      <view class="bookmark-block-title">最近查看</view>
      <scroll-view scroll-x class="recent-scroll" enhanced show-scrollbar="{{false}}">
        <view class="recent-track">
          <view wx:for="{{recentViews}}" wx:key="char" class="recent-chip" data-char="{{item.char}}" bindtap="openBookmark">
            <text class="recent-chip-char">{{item.char}}</text>
            <text wx:if="{{item.pinyin}}" class="recent-chip-pinyin">{{item.pinyin}}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <view wx:if="{{hasBookmarks}}" class="bookmark-grid">
      <view wx:for="{{bookmarks}}" wx:key="char" class="bookmark-cell" data-char="{{item.char}}" bindtap="openBookmark" bindlongpress="removeBookmark">
        <text class="bm-char">{{item.char}}</text>
        <text wx:if="{{item.pinyin}}" class="bm-pinyin">{{item.pinyin}}</text>
      </view>
    </view>
    <view wx:if="{{hasBookmarks}}" class="bookmark-groups">
      <view wx:for="{{bookmarkGroups}}" wx:key="radical" wx:for-item="group" class="bookmark-group">
        <view class="bookmark-group-head">
          <view class="bookmark-group-title">{{group.radical}}部</view>
          <view class="bookmark-group-count">{{group.count}} 字</view>
        </view>
        <view class="bookmark-group-list">
          <view wx:for="{{group.items}}" wx:key="char" wx:for-item="bm" class="bookmark-mini" data-char="{{bm.char}}" bindtap="openBookmark">{{bm.char}}</view>
        </view>
      </view>
    </view>
    <view wx:else class="empty">
      <view class="empty-icon">★</view>
      <view class="empty-title">尚无收藏</view>
      <view class="empty-body">在「字形」页面查看字形时点击右侧星标即可收藏。</view>
    </view>
  </view>

  <!-- Mistake preview -->
  <view class="card">
    <view class="section-row">
      <view>
        <view class="section-title">错题本</view>
        <view class="section-sub">最近 {{mistakesPreview.length}} 条猜字错题</view>
      </view>
      <view wx:if="{{hasMistakes}}" class="btn btn-ghost btn-sm" bindtap="clearMistakes">清空</view>
    </view>

    <view wx:if="{{hasMistakes}}" class="profile-mistake-list">
      <view wx:for="{{mistakesPreview}}" wx:key="id" class="profile-mistake-row" data-char="{{item.char}}" bindtap="reviewMistake">
        <view class="profile-mistake-pair">
          <text class="profile-mistake-ok">{{item.char}}</text>
          <text class="profile-mistake-vs">/</text>
          <text class="profile-mistake-wrong">{{item.chosen}}</text>
        </view>
        <view class="profile-mistake-meta">
          <view class="profile-mistake-title">正确「{{item.char}}」，误选「{{item.chosen}}」</view>
          <view class="profile-mistake-sub">{{item.stageLabel}}<text wx:if="{{item.count > 1}}"> · {{item.count}}次</text></view>
        </view>
        <view class="row-value">›</view>
      </view>
    </view>
    <view wx:else class="empty compact-empty">
      <view class="empty-title">暂无错题</view>
      <view class="empty-body">在学习页或字形页参与猜字测验后，答错记录会出现在这里。</view>
    </view>
  </view>

  <!-- Settings -->
  <view class="card">
    <view class="section-title mb-sm">设置</view>
    <view class="row" bindtap="toggleFontSize">
      <view class="row-label">字号</view>
      <view class="row-value">{{settings.fontSize === 'small' ? '小' : settings.fontSize === 'large' ? '大' : '中'}}</view>
    </view>
    <view class="row" bindtap="toggleTheme">
      <view class="row-label">深色模式</view>
      <view class="switch {{settings.theme === 'dark' ? 'switch-on' : ''}}">
        <view class="switch-dot"></view>
      </view>
    </view>
    <view class="row row-chev" bindtap="copyContact">
      <view class="row-label">联系我们</view>
      <view class="row-value">复制邮箱</view>
    </view>
    <view class="row row-chev" bindtap="showAbout">
      <view class="row-label">关于说文</view>
      <view class="row-value">v1.0.0</view>
    </view>
    <view class="row" bindtap="clearCache">
      <view class="row-label" style="color:#DC2626">清除缓存</view>
      <view class="row-value">›</view>
    </view>
  </view>

</view>
