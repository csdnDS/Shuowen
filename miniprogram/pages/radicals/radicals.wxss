.radical-card {
  background: #FFFFFF;
  border: 1rpx solid #ECECEA;
  border-radius: 14rpx;
  margin-bottom: 14rpx;
  overflow: hidden;
}

.radical-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx 22rpx;
}

.radical-head:active {
  background: #FAFAF8;
}

.radical-seal {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  background: #F5F5F3;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 600;
  color: #1A1A1A;
  flex-shrink: 0;
}

.radical-meta {
  flex: 1;
  min-width: 0;
}

.radical-name {
  color: #1A1A1A;
  font-size: 30rpx;
  font-weight: 600;
}

.radical-meaning {
  color: #6B6B6B;
  font-size: 24rpx;
  margin-top: 4rpx;
}

.radical-count {
  color: #A0A0A0;
  font-size: 22rpx;
  background: #F5F5F3;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.radical-toggle {
  color: #2563EB;
  font-size: 24rpx;
  margin-left: 8rpx;
}

.radical-body {
  padding: 0 22rpx 22rpx;
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 10rpx;
}

.char-cell {
  display: flex;
  align-items: center;
  justify-content: center;
  aspect-ratio: 1 / 1;
  background: #FAFAF8;
  border: 1rpx solid #ECECEA;
  border-radius: 10rpx;
  font-size: 36rpx;
  color: #1A1A1A;
}

.char-cell:active {
  background: #EFF6FF;
  color: #2563EB;
  border-color: #BFDBFE;
}
