<view class="page">

  <view class="page-header">
    <view class="eyebrow">RADICAL INDEX</view>
    <view class="page-title">部首索引</view>
    <view class="page-subtitle">以部首为线索，浏览同源字族；轻触字格查看字形演变。</view>
  </view>

  <view wx:if="{{offline}}" class="banner banner-info mb-md">
    <text>当前未连接到本地服务，显示离线示例数据。</text>
  </view>

  <!-- Search / filter bar -->
  <view class="card filter-card">
    <view class="filter-row">
      <input class="filter-input" value="{{keyword}}" bindinput="onKeywordInput" placeholder="搜索部首、含义或例字" placeholder-class="filter-placeholder" />
      <view wx:if="{{keyword}}" class="filter-clear" bindtap="clearKeyword">✕</view>
    </view>
    <view wx:if="{{keyword}}" class="filter-hint">找到 {{resultCount}} 个部首</view>
  </view>

  <view wx:if="{{loading}}" class="card">
    <view class="loading-shimmer" style="height:120rpx; border-radius:12rpx; margin-bottom:16rpx"></view>
    <view class="loading-shimmer" style="height:120rpx; border-radius:12rpx"></view>
  </view>

  <view wx:elif="{{hasRadicals}}">
    <view wx:for="{{radicals}}" wx:key="radical" class="radical-card">
      <view class="radical-head" data-radical="{{item.radical}}" bindtap="toggleRadical">
        <view class="radical-seal">{{item.radical}}</view>
        <view class="radical-meta">
          <view class="radical-name">{{item.radical}}部<text wx:if="{{item.pinyin}}" class="radical-pinyin"> · {{item.pinyin}}</text></view>
          <view class="radical-meaning">{{item.meaning}}</view>
        </view>
        <view class="radical-count">
          {{item.countText}}
          <text wx:if="{{item.detailCount > 0}}" class="radical-detail-badge"> · {{item.detailCount}}详</text>
        </view>
        <view class="radical-toggle">{{item.expandText}}</view>
      </view>

      <view wx:if="{{item.expanded}}" class="radical-body">
        <view wx:for="{{item.examples}}" wx:for-item="ex" wx:key="char"
              class="char-cell {{ex.hasDetail ? 'char-cell-detail' : ''}}"
              data-char="{{ex.char}}" bindtap="goToEvolution">
          <text>{{ex.char}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:elif="{{keyword}}" class="card empty">
    <view class="empty-icon">搜</view>
    <view class="empty-title">未找到匹配部首</view>
    <view class="empty-body">请尝试其他汉字或关键词。</view>
  </view>

  <view wx:else class="card empty">
    <view class="empty-icon">部</view>
    <view class="empty-title">暂无部首数据</view>
    <view class="empty-body">正在加载中，或请检查网络连接。</view>
  </view>

</view>
